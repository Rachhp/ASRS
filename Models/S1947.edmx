    [vw_TransactionReport].[Action] AS [Action], 
    [vw_TransactionReport].[CreatedBy] AS [CreatedBy], 
    [vw_TransactionReport].[CreatedOn] AS [CreatedOn]
    FROM [dbo].[vw_TransactionReport] AS [vw_TransactionReport]</DefiningQuery>
