@using S1947.Models
@model S1947.Models.AndonViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: #ececec;
        font-family: Calibri,Arial,sans-serif;
        font-size: 13px;
        color: #000;
    }
    /*========================
            MAIN CONTAINER
        =========================*/
    .loading-container {
        width: 100%;
        background: #fff;
        border: 2px solid #000;
        padding: 15px;
    }
    /*========================
              HEADER
        =========================*/
    .header-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

    .header-left {
        width: 18%;
    }

    .header-center {
        width: 55%;
        text-align: center;
    }

    .header-right {
        width: 27%;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 10px;
    }

    .titleText {
        font-size: 28px;
        font-weight: bold;
        color: #000;
        text-decoration: underline;
        margin: 0;
    }

    .btn-print {
        background: #1F4E78;
        color: #fff;
        border: none;
        padding: 7px 18px;
        font-weight: bold;
        cursor: pointer;
    }

        .btn-print:hover {
            background: #17375E;
        }

    .dockBox {
        display: flex;
        align-items: center;
        background: #1F4E78;
        color: #fff;
        border: 1px solid #000;
        font-weight: bold;
    }

        .dockBox span:first-child {
            padding: 8px 12px;
        }

    .dockValue {
        background: #fff;
        color: #000;
        padding: 8px 18px;
        min-width: 90px;
        text-align: center;
        border-left: 1px solid #000;
    }
    /*========================
              INFORMATION ROW
        =========================*/
    .loading-info {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        margin: 18px 0;
    }

    .info-field {
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .info-field label {
            font-weight: bold;
        }

        .info-field span {
            display: inline-block;
            min-width: 120px;
            border: 1px solid #000;
            padding: 5px 10px;
            background: #fff;
        }

    .status-field {
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .status-field label {
            font-weight: bold;
        }

    .statusBox {
        padding: 7px 15px;
        font-weight: bold;
        border: 1px solid #000;
    }

    .statusRed {
        background: #d32f2f;
        color: #fff;
    }

    .statusYellow {
        background: #FFD966;
        color: #000;
    }

    .statusGreen {
        background: #70AD47;
        color: #fff;
    }
    /*========================
                TABLE
        =========================*/
    .table-scroll {
        width: 100%;
        overflow: auto;
        margin-top: 10px;
    }

    .loading-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12px;
    }

        .loading-table th {
            background: #1F4E78;
            color: #fff;
            border: 1px solid #000;
            padding: 8px;
            text-align: center;
        }

        .loading-table td {
            border: 1px solid #000;
            padding: 6px;
            text-align: center;
            vertical-align: middle;
        }

        .loading-table tbody tr:nth-child(even) {
            background: #F6F6F6;
        }

        .loading-table tbody tr:hover {
            background: #EAF2FF;
        }

    .totalRow td {
        background: #D9EAD3;
        font-weight: bold;
    }
    /*========================
              VEHICLE LAYOUT
        =========================*/
    .vehicle-section {
        display: flex;
        align-items: center;
        margin-top: 20px;
    }

    .vehicle-label {
        width: 180px;
        height: 70px;
        background: #1F4E78;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 15px;
        border: 1px solid #000;
        text-align: center;
    }

    .vehicle-display {
        margin-left: 20px;
    }

    .vehicle-grid {
        border-collapse: collapse;
    }

        .vehicle-grid td {
            width: 45px;
            height: 35px;
            border: 1px solid #000;
            text-align: center;
            font-weight: bold;
            background: #fff;
        }

            .vehicle-grid td.filled {
                background: #70AD47 !important;
                color: white;
            }
    /*========================
            SIGNATURE SECTION
        =========================*/
    .signature-section {
        margin-top: 25px;
    }

    .signature-table {
        width: 100%;
        border-collapse: collapse;
    }

        .signature-table th {
            background: #1F4E78;
            color: #fff;
            border: 1px solid #000;
            padding: 8px;
        }

        .signature-table td {
            border: 1px solid #000;
            padding: 8px;
            text-align: center;
        }

    .signature-space {
        height: 70px;
    }
    /*========================
              SCROLLBAR
        =========================*/
    .table-scroll::-webkit-scrollbar {
        height: 10px;
    }

    .table-scroll::-webkit-scrollbar-thumb {
        background: #888;
    }

    .table-scroll::-webkit-scrollbar-track {
        background: #ddd;
    }
    /*========================
                PRINT
        =========================*/
    @@media print {
        /* Hide complete application layout */
        body > *:not(section) {
            display: none !important;
        }

        .sidebar,
        .navbar,
        header,
        footer,
        .menu {
            display: none !important;
        }
        /* Print sheet only */
        .print-area {
            display: block !important;
            width: 100% !important;
            margin: 0 !important;
            padding: 10px !important;
        }
        /* Header */
        .row {
            display: flex !important;
        }
        /* Loading table */
        .table-scroll {
            overflow: visible !important;
            max-height: none !important;
        }

        .loading-table {
            width: 100% !important;
            min-width: 0 !important;
            font-size: 10px;
        }
        /* Vehicle section */
        .vehicle-section {
            display: flex !important;
            align-items: center !important;
        }
        /* Bottom three boxes */
        .bottom-section {
            display: flex !important;
            flex-direction: row !important;
            width: 100% !important;
            gap: 15px !important;
            margin-top: 20px !important;
        }

        .person-box {
            display: block !important;
            width: 33.33% !important;
        }

        .person-table {
            display: table !important;
            width: 100% !important;
            border-collapse: collapse !important;
        }

            .person-table tr {
                display: table-row !important;
            }

            .person-table td {
                display: table-cell !important;
                border: 1px solid #000 !important;
                padding: 6px !important;
            }

        .signature-row td {
            height: 70px !important;
        }
        /* Hide print button */
        .btn-print {
            display: none !important;
        }
    }
    /*========================
              MOBILE
        =========================*/
    @@media(max-width:992px) {
        .header-section {
            flex-direction: column;
            gap: 15px;
        }

        .header-left,
        .header-center,
        .header-right {
            width: 100%;
            text-align: center;
        }

        .header-right {
            align-items: center;
        }

        .loading-info {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }

        .titleText {
            font-size: 22px;
        }

        .loading-table {
            font-size: 11px;
        }
    }

    .bottom-section {
        display: flex;
        gap: 20px;
        margin-top: 25px;
    }

    .person-box {
        flex: 1;
    }

    .person-table {
        width: 100%;
        border-collapse: collapse;
    }

        .person-table td {
            border: 1px solid #000;
            padding: 8px;
        }

    .label-cell {
        width: 45%;
        background: #f2f2f2;
    }

    .signature-row td {
        height: 70px;
    }

    @@media(max-width:900px) {
        .bottom-section {
            flex-direction: column;
        }
    }

    .truck-side-container {
        display: flex;
        gap: 40px;
        margin-left: 20px;
    }

    .side-view {
        border: 2px solid #000;
        padding: 10px;
        background: #fff;
    }

    .side-title {
        background: #1F4E78;
        color: white;
        font-weight: bold;
        text-align: center;
        padding: 5px;
        margin-bottom: 8px;
    }

    .vehicle-grid {
        border-collapse: collapse;
    }

        .vehicle-grid td {
            width: 45px;
            height: 35px;
            border: 1px solid #000;
            text-align: center;
            font-weight: bold;
            background: #fff;
        }

            .vehicle-grid td.filled {
                background: #70AD47 !important;
                color: white;
            }

    .truck-layout {
        display: flex;
        align-items: center;
        border: 3px solid #000;
        margin-left: 20px;
        background: #eee;
        padding: 10px;
    }

    .truck-side {
        background: white;
    }

    .side-name {
        background: #1F4E78;
        color: white;
        font-weight: bold;
        text-align: center;
        padding: 5px;
    }

    .truck-divider {
        width: 20px;
    }

    .truck-grid {
        border-collapse: collapse;
    }

        .truck-grid td {
            width: 45px;
            height: 35px;
            border: 1px solid #000;
            text-align: center;
            font-weight: bold;
            background: #fff;
        }

            .truck-grid td.filled {
                background: #70AD47;
                color: white;
            }

    .truck-body {
        border: 3px solid #000;
        background: #fff;
        padding: 10px;
        margin-left: 20px;
    }


    .side-title {
        background: #1F4E78;
        color: white;
        font-weight: bold;
        text-align: center;
        padding: 5px;
    }


    .side-gap {
        height: 15px;
    }



    .vehicle-grid {
        border-collapse: collapse;
        margin: auto;
    }


        .vehicle-grid td {
            width: 45px;
            height: 35px;
            border: 1px solid #000;
            text-align: center;
            font-weight: bold;
        }



            .vehicle-grid td.filled {
                background: #70AD47;
                color: white;
            }
</style>
<section role="main">
    <div class="loading-container print-area">
        <div id="loadingSheet">
            <!-- ================= HEADER ================= -->
            <div class="header-section">
                <div class="header-left">
                    <img src="~/Scripts/img/minda.jpg" style="height:70px;" />
                </div>
                <div class="header-center">
                    <h2 class="titleText">
                        MATERIAL LOADING SHEET
                    </h2>
                </div>
                <div class="header-right">
                    <button onclick="printLoadingSheet()" class="btn-print">
                        PRINT
                    </button>
                    <div class="dockBox">
                        <span>
                            DOCK NO
                        </span>
                        <span class="dockValue">
                            @Model.DockNo
                        </span>
                    </div>
                </div>
            </div>
            <hr />
            <!-- ================= DATE TIME STATUS ================= -->
            <div class="loading-info">
                <div class="info-field">
                    <label>
                        Date :
                    </label>
                    <span id="currentDate"></span>
                </div>
                <div class="info-field">
                    <label>
                        Time :
                    </label>
                    <span id="currentTime"></span>
                </div>
                <div class="info-field">
                    <label>
                        Shift :
                    </label>
                    <span id="shiftName"></span>
                </div>
                <div class="status-field">
                    <label>
                        Vehicle Loading Status :
                    </label>
                    @if (Model.VehicleLoadingStatus == "R")
                    {
                        <span class="statusBox statusRed">
                            NOT YET STARTED
                        </span>
                    }
                    else if (Model.VehicleLoadingStatus == "Y")
                    {
                        <span class="statusBox statusYellow">
                            IN PROCESS
                        </span>
                    }
                    else
                    {
                        <span class="statusBox statusGreen">
                            COMPLETED
                        </span>
                    }
                </div>
            </div>
            <hr />
            <!-- ================= LOADING DETAILS TABLE ================= -->
            <div class="table-scroll">
                <table class="loading-table">
                    <thead>
                        <tr>
                            <th>Sr No</th>
                            <th>Invoice No</th>
                            <th>Customer</th>
                            <th>Location</th>
                            <th>Part No</th>
                            <th>Part Description</th>
                            <th>SAP FG Code</th>
                            <th>Available Qty</th>
                            <th>Part Qty</th>
                            <th>FLC Qty</th>
                            <th>Vehicle Size</th>
                            <th>Vehicle No</th>
                            <th>Transporter</th>
                            <th>Loading Start Time</th>
                            <th>Loading End Time</th>
                            <th>Seal No</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.LoadingHistory != null)
                        {
                            int sr = 1;
                            foreach (var item in Model.LoadingHistory)
                            {
                                <tr>
                                    <td>
                                        @sr
                                    </td>
                                    <td> @item.InvoiceNo </td>
                                    <td> @item.Customer</td>
                                    <td> @item.Location </td>
                                    <td> @item.Model </td>
                                    <td> @item.Description</td>
                                    <td> @item.SAPFGCode</td>
                                    <td> @item.AvailableQty </td>
                                    <td> @item.EnteredQty </td>
                                    <td> @item.FLCQty </td>
                                    <td> @item.VehicleSize </td>
                                    <td> @item.VehicleRegNo </td>
                                    <td> @item.TransporterName</td>
                                    <td></td>
                                    <td> </td>
                                    <td> @item.VehicleSealNo</td>
                                </tr>
                                sr++;
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr class="totalRow">
                            <td colspan="8">
                                TOTAL
                            </td>
                            <td id="totalQty">
                                0
                            </td>
                            <td id="totalFLC">
                                0
                            </td>
                            <td colspan="6">
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <!-- ================= VEHICLE LOADING LAYOUT ================= -->
            <div class="vehicle-section">

                <div class="vehicle-label">
                    Vehicle Loading Status
                </div>


                <div class="truck-body">


                    <div class="side-title">
                        LH Side View
                    </div>

                    <table id="lhGrid" class="vehicle-grid"></table>



                    <div class="side-gap"></div>



                    <div class="side-title">
                        RH Side View
                    </div>

                    <table id="rhGrid" class="vehicle-grid"></table>


                </div>

            </div>
            <!-- ================= SIGNATURE AREA ================= -->
            <div class="bottom-section">
                <!-- SUPERVISOR -->
                <div class="person-box">
                    <table class="person-table">
                        <tr>
                            <td class="label-cell"> <b>Supervisor Name</b></td>
                            <td> @Model.SupervisiorName </td>
                        </tr>
                        <tr class="signature-row">
                            <td><b>Sign. of Supervisor</b> </td>
                            <td></td>
                        </tr>
                        <tr>
                            <td><b>Mobile Number</b></td>
                            <td> @Model.MobileNoSupervisor </td>
                        </tr>
                    </table>
                </div>
                <!-- DRIVER -->
                <div class="person-box">
                    <table class="person-table">
                        <tr>
                            <td class="label-cell"><b>Driver Name</b> </td>
                            <td> @Model.DriverName</td>
                        </tr>
                        <tr class="signature-row">
                            <td> <b>Sign. of Driver</b></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td><b>Mobile</b></td>
                            <td> @Model.MobileNoDriver </td>
                        </tr>
                    </table>
                </div>
                <!-- SECURITY -->
                <div class="person-box">
                    <table class="person-table">
                        <tr>
                            <td class="label-cell"> <b>Security Name</b></td>
                            <td> @Model.SecurityName </td>
                        </tr>
                        <tr class="signature-row">
                            <td> <b>Sign. of Security</b> </td>
                            <td></td>
                        </tr>
                        <tr>
                            <td><b>Mobile Number</b></td>
                            <td> @Model.MobileNoSecurity</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
<script>
    $(document).ready(function () {
        updateDateTime();
        setInterval(updateDateTime, 1000);
        calculateTotal();
        createVehicleGrid();
        updateVehicleSlots();
    });
    //================ DATE TIME SHIFT =================
    function updateDateTime() {
        let now = new Date();
        let date =
            now.toLocaleDateString('en-IN');
        let time =
            now.toLocaleTimeString('en-IN');
        $("#currentDate").text(date);
        $("#currentTime").text(time);
        let hour = now.getHours();
        let shift = "";
        if (hour >= 6 && hour < 14) {
            shift = "Shift A";
        }
        else if (hour >= 14 && hour < 22) {
            shift = "Shift B";
        }
        else {
            shift = "Shift C";
        }
        $("#shiftName").text(shift);
    }
    //================ TOTAL CALCULATION =================
    function calculateTotal() {
        let totalQty = 0;
        let totalFLC = 0;
        $("#loadingBody tr").each(function () {
            let qty =
                parseFloat($(this).find("td:eq(8)").text())
                || 0;
            let flc =
                parseFloat($(this).find("td:eq(9)").text())
                || 0;
            totalQty += qty;
            totalFLC += flc;
        });
        $("#totalQty").text(totalQty);
        $("#totalFLC").text(totalFLC);
    }
    //================ VEHICLE GRID =================
    //================ VEHICLE GRID =================
    let totalVehicleSlots = 0;
    function createVehicleGrid() {
        let vehicleSize = "";
        $("#loadingBody tr:first td").each(function (index) {
            if (index == 10) {
                vehicleSize = $(this).text().trim();
            }
        });
        let columns = 7; // default 28
        if (vehicleSize == "32") {
            columns = 9; // 36 slots
        }
        createSide("#lhGrid", columns);
        createSide("#rhGrid", columns);
    }
    function createSide(id, columns) {
        let html = "";
        let odd = 1;
        let even = 2;
        // Odd row
        html += "<tr>";
        for (let i = 0; i < columns; i++) {
            html += `
        <td data-slot="${odd}">
            ${odd}
        </td>`;
            odd += 2;
        }
        html += "</tr>";
        // Even row
        html += "<tr>";
        for (let i = 0; i < columns; i++) {
            html += `
        <td data-slot="${even}">
            ${even}
        </td>`;
            even += 2;
        }
        html += "</tr>";
        $(id).html(html);
    }
    // Create LH/RH grid
    function createSideGrid(element, count) {
        let html = "";
        let halfRow = count / 2;
        let odd = 1;
        let even = 2;
        // Odd row
        html += "<tr>";
        for (let i = 0; i < halfRow; i++) {
            html += `
        <td data-slot="${odd}">
            ${odd}
        </td>
        `;
            odd += 2;
        }
        html += "</tr>";
        // Even row
        html += "<tr>";
        for (let i = 0; i < halfRow; i++) {
            html += `
        <td data-slot="${even}">
            ${even}
        </td>
        `;
            even += 2;
        }
        html += "</tr>";
        $(element).html(html);
    }
    //================ UPDATE LOADING =================
    function updateVehicleSlots() {
        let used = 0;
        $("#loadingBody tr").each(function () {
            let flc =
                parseFloat(
                    $(this).find("td:eq(9)").text()
                ) || 0;
            used += flc;
        });
        used = Math.round(used);
        let current = 1;
        // Fill LH first
        $("#lhGrid td").each(function () {
            let slot = $(this).data("slot");
            if (current <= used) {
                $(this).addClass("filled");
            }
            current++;
        });
        // Remaining fill RH
        $("#rhGrid td").each(function () {
            if (current <= used) {
                $(this).addClass("filled");
            }
            current++;
        });
    }
    function updateVehicleSlots() {
        let used = 0;
        $("#loadingBody tr").each(function () {
            let flc = parseFloat(
                $(this).find("td:eq(9)").text()
            ) || 0;
            used += flc;
        });
        used = Math.round(used);
        $("#vehicleGrid td").each(function () {
            let slot = parseInt($(this).data("slot"));
            if (slot <= used) {
                $(this).addClass("filled");
            }
        });
    }
    //================ PRINT =================
    function printLoadingSheet() {
        window.print();
    }
    //function printSheet(){
    //    window.print();
    //}
</script>