@using S1947.Models
@model S1947.Models.AndonViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    var startTime = DateTime.Now;
    var endTime = startTime.AddSeconds(3);
}
<style>
        /*to hide the foter print*/
        .print-document-header,
        .print-document-footer {
            display: none !important;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #ececec;
            font-family: Calibri,Arial,sans-serif;
            font-size: 13px;
            color: #000;
        }
        /*========================
                MAIN CONTAINER
            =========================*/
        .loading-container {
            width: 100%;
            background: #fff;
            border: 1px solid #000;
            padding: 15px;
        }
        /*========================
                  HEADER
            =========================*/
        .header-section {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .header-left {
            width: 18%;
        }

        .header-center {
            width: 55%;
            text-align: center;
        }

        .header-right {
            width: 27%;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 10px;
        }

        .titleText {
            font-size: 28px;
            font-weight: bold;
            color: #000;
            /*            text-decoration: underline;*/
            margin: 0;
        }

        .btn-print {
            background: #1F4E78;
            color: #fff;
            border: none;
            padding: 7px 18px;
            font-weight: bold;
            cursor: pointer;
        }

            .btn-print:hover {
                background: #17375E;
            }

        .dockBox {
            display: flex;
            align-items: center;
            background: #1F4E78;
            color: #fff;
            border: 1px solid #000;
            font-weight: bold;
        }

            .dockBox span:first-child {
                padding: 8px 12px;
            }

        .dockValue {
            background: #fff;
            color: #000;
            padding: 8px 18px;
            min-width: 90px;
            text-align: center;
            border-left: 1px solid #000;
        }
        /*========================
                  INFORMATION ROW
            =========================*/

        .loading-info {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            margin: 18px 0;
        }

        .info-field {
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .info-field label {
                font-weight: bold;
            }

            .info-field span {
                display: inline-block;
                min-width: 120px;
                border: 1px solid #000;
                padding: 5px 10px;
                background: #fff;
            }

        .status-field {
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .status-field label {
                font-weight: bold;
            }

        .statusBox {
            padding: 7px 15px;
            font-weight: bold;
            border: 1px solid #000;
        }

        .statusRed {
            background: #d32f2f;
            color: #fff;
        }

        .statusYellow {
            background: #FFD966;
            color: #000;
        }

        .statusGreen {
            background: #70AD47;
            color: #fff;
        }
        /*========================
                    TABLE
            =========================*/
        .table-scroll {
            width: 100%;
            overflow: auto;
            margin-top: 10px;
        }

        .loading-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
        }

            .loading-table th {
                background: #1F4E78;
                color: #fff;
                border: 1px solid #000;
                padding: 8px;
                text-align: center;
            }

            .loading-table td {
                border: 1px solid #000;
                padding: 6px;
                text-align: center;
                vertical-align: middle;
            }

            .loading-table tbody tr:nth-child(even) {
                background: #F6F6F6;
            }

            .loading-table tbody tr:hover {
                background: #EAF2FF;
            }

        .totalRow td {
            background: #D9EAD3;
            font-weight: bold;
        }

        /*========================
                SIGNATURE SECTION
            =========================*/
        .signature-section {
            margin-top: 25px;
        }

        .signature-table {
            width: 100%;
            border-collapse: collapse;
        }

            .signature-table th {
                background: #1F4E78;
                color: #fff;
                border: 1px solid #000;
                padding: 8px;
            }

            .signature-table td {
                border: 1px solid #000;
                padding: 8px;
                text-align: center;
            }

        .signature-space {
            height: 70px;
        }
        /*========================
                  SCROLLBAR
            =========================*/
        .table-scroll::-webkit-scrollbar {
            height: 10px;
        }

        .table-scroll::-webkit-scrollbar-thumb {
            background: #888;
        }

        .table-scroll::-webkit-scrollbar-track {
            background: #ddd;
        }
        /*========================
                    PRINT
            =========================*/
        /*========================
            PRINT
    =========================*/
        @@media print {
            /*========================
        DOCUMENT HEADER
    ========================*/

            .print-document-header {
                display: flex !important;
                width: 100% !important;
                justify-content: space-between !important;
                align-items: center !important;
                border: 1px solid #000 !important;
                padding: 4px 8px !important;
                margin-bottom: 5px !important;
                font-size: 9px !important;
                font-weight: bold !important;
            }

            .document-header-left,
            .document-header-center,
            .document-header-right {
                width: 33.33% !important;
                white-space: nowrap !important;
            }

            .document-header-center {
                text-align: center !important;
            }

            .document-header-right {
                text-align: right !important;
            }
            /*========================
        DOCUMENT FOOTER
    ========================*/

            .print-document-footer {
                display: flex !important;
                width: 100% !important;
                justify-content: space-between !important;
                align-items: center !important;
                border: 1px solid #000 !important;
                padding: 4px 8px !important;
                margin-top: 6px !important;
                font-size: 9px !important;
                font-weight: bold !important;
            }

                .print-document-footer > div {
                    width: 33.33% !important;
                    white-space: nowrap !important;
                }

                    .print-document-footer > div:nth-child(2) {
                        text-align: center !important;
                    }

                    .print-document-footer > div:nth-child(3) {
                        text-align: right !important;
                    }

            .print-document-footer {
                display: flex !important;
            }

            @@page {
                size: A4 landscape;
                margin: 5mm;
            }

            html,
            body {
                width: 100% !important;
                margin: 0 !important;
                padding: 0 !important;
            }
                /* Hide application layout */
                body > *:not(section) {
                    display: none !important;
                }

            .sidebar,
            .navbar,
            header,
            footer,
            .menu,
            .btn-print {
                display: none !important;
            }
            /* Main print area */
            section[role="main"] {
                display: block !important;
                width: 100% !important;
                margin: 0 !important;
                padding: 0 !important;
            }

            .loading-container,
            .print-area {
                display: block !important;
                width: 100% !important;
                margin: 0 !important;
                padding: 5px !important;
                border: 2px solid #000 !important;
            }

            #loadingSheet {
                width: 100% !important;
                margin: 0 !important;
                padding: 0 !important;
            }
            /*========================
              PRINT HEADER
        ========================*/

            .header-section {
                display: flex !important;
                flex-direction: row !important;
                flex-wrap: nowrap !important;
                justify-content: space-between !important;
                align-items: center !important;
                width: 100% !important;
                margin: 0 0 5px 0 !important;
                padding: 0 !important;
            }

            .header-left {
                width: 18% !important;
                flex: 0 0 18% !important;
            }

            .header-center {
                width: 57% !important;
                flex: 0 0 57% !important;
            }

            .header-right {
                width: 25% !important;
                flex: 0 0 25% !important;
            }

            .header-left img {
                height: 55px !important;
                width: auto !important;
                max-height: 55px !important;
                display: block !important;
            }

            .titleText {
                font-size: 22px !important;
                line-height: 1.1 !important;
                margin: 0 !important;
                padding: 0 !important;
                white-space: nowrap !important;
            }

            .dockBox {
                display: flex !important;
                flex-direction: row !important;
                align-items: center !important;
                justify-content: flex-end !important;
                max-width: 100% !important;
                width: auto !important;
                min-width: 0 !important;
                margin: 0 !important;
                white-space: nowrap !important;
                box-sizing: border-box !important;
            }

                .dockBox span:first-child {
                    padding: 5px 6px !important;
                    font-size: 9px !important;
                }

            .dockValue {
                padding: 5px 7px !important;
                min-width: 35px !important;
                font-size: 10px !important;
            }
            /* Horizontal line */
            .header-section + hr {
                margin: 3px 0 6px 0 !important;
                padding: 0 !important;
            }
            /*========================
            DATE / TIME / SHIFT
        ========================*/

            .loading-info {
                display: flex !important;
                flex-direction: row !important;
                flex-wrap: nowrap !important;
                justify-content: space-between !important;
                align-items: center !important;
                width: 100% !important;
                margin: 5px 0 !important;
                padding: 0 !important;
                gap: 8px !important;
            }

            .info-field,
            .status-field {
                display: flex !important;
                flex-direction: row !important;
                align-items: center !important;
                flex-wrap: nowrap !important;
                white-space: nowrap !important;
                gap: 4px !important;
            }

                .info-field label,
                .status-field label {
                    white-space: nowrap !important;
                    font-size: 10px !important;
                }

                .info-field span {
                    min-width: 80px !important;
                    padding: 3px 5px !important;
                    white-space: nowrap !important;
                    font-size: 10px !important;
                }

            .statusBox {
                padding: 4px 7px !important;
                white-space: nowrap !important;
                font-size: 10px !important;
            }

            .loading-info + hr {
                margin: 3px 0 6px 0 !important;
            }
            /*========================
              LOADING TABLE
        ========================*/

            .table-scroll {
                width: 100% !important;
                overflow: visible !important;
                max-height: none !important;
                margin: 0 !important;
                padding: 0 !important;
            }

            .loading-table {
                width: 100% !important;
                min-width: 0 !important;
                table-layout: auto !important;
                border-collapse: collapse !important;
                font-size: 8px !important;
            }

                .loading-table th {
                    padding: 4px 3px !important;
                    white-space: nowrap !important;
                }

                .loading-table td {
                    padding: 3px 2px !important;
                    white-space: nowrap !important;
                }

                .loading-table thead {
                    display: table-header-group !important;
                }

                .loading-table tr {
                    page-break-inside: avoid !important;
                }

                .loading-table tfoot {
                    display: table-footer-group !important;
                }
            /*========================
              VEHICLE SECTION
        ========================*/

            .vehicle-section {
                display: flex !important;
                flex-direction: row !important;
                align-items: flex-start !important;
                justify-content: flex-start !important;
                width: 100% !important;
                margin-top: 8px !important;
                padding: 0 !important;
            }

            .vehicle-layout-table {
                margin: 0 !important;
                box-shadow: none !important;
            }

                .vehicle-layout-table td {
                    width: 55px !important;
                    height: 22px !important;
                    font-size: 10px !important;
                    padding: 2px !important;
                }

            .vehicle-title {
                width: 100px !important;
                font-size: 11px !important;
            }
            /*========================
              SIGNATURE SECTION
        ========================*/

            .bottom-section {
                display: flex !important;
                flex-direction: row !important;
                flex-wrap: nowrap !important;
                width: 100% !important;
                gap: 8px !important;
                margin-top: 10px !important;
                padding: 0 !important;
            }

            .person-box {
                display: block !important;
                width: 33.33% !important;
                flex: 1 1 33.33% !important;
            }

            .person-table {
                display: table !important;
                width: 100% !important;
                border-collapse: collapse !important;
            }

                .person-table tr {
                    display: table-row !important;
                }

                .person-table td {
                    display: table-cell !important;
                    border: 1px solid #000 !important;
                    padding: 4px !important;
                    font-size: 9px !important;
                }

            .signature-row td {
                height: 45px !important;
            }
        }
        /*========================
                  MOBILE
            =========================*/
        @@media(max-width:992px) {
            .header-section {
                flex-direction: column;
                gap: 15px;
            }

            .header-left,
            .header-center,
            .header-right {
                width: 100%;
                text-align: center;
            }

            .header-right {
                align-items: center;
            }

            .loading-info {
                flex-direction: column;
                align-items: flex-start;
                gap: 10px;
            }

            .titleText {
                font-size: 22px;
            }

            .loading-table {
                font-size: 11px;
            }
        }

        .bottom-section {
            display: flex;
            gap: 20px;
            margin-top: 25px;
        }

        .person-box {
            flex: 1;
        }

        .person-table {
            width: 100%;
            border-collapse: collapse;
        }

            .person-table td {
                border: 1px solid #000;
                padding: 8px;
            }

        .label-cell {
            width: 45%;
            background: #f2f2f2;
        }

        .signature-row td {
            height: 70px;
        }

        @@media(max-width:900px) {
            .bottom-section {
                flex-direction: column;
            }
        }

        /*========================
        VEHICLE LAYOUT
        ========================*/

        .vehicle-section {
            margin-top: 25px;
            display: flex;
            justify-content: left;
        }

        .vehicle-layout-table {
            border-collapse: collapse;
            border: 2px solid #1F4E78;
            box-shadow: 0 2px 6px rgba(0,0,0,.15);
            background: #fff;
        }

            .vehicle-layout-table td {
                width: 80px;
                height: 32px;
                text-align: center;
                vertical-align: middle;
                border: 1px solid #999;
                font-weight: bold;
                font-size: 14px;
                background: #F3F3F3;
                transition: .2s;
            }

                .vehicle-layout-table td:hover {
                    background: #D9EAF7;
                }

        .vehicle-title {
            width: 150px;
            background: #1F4E78 !important;
            color: #fff;
            font-size: 18px;
            font-weight: bold;
            border-right: 2px solid #000 !important;
            letter-spacing: .5px;
        }

            .vehicle-title div {
                line-height: 32px;
            }

        .vehicle-layout-table td.filled {
            background: #70AD47 !important;
            color: #fff;
            border-color: #4F7F32;
        }

        .vehicle-layout-table td {
            background: #ECECEC;
        }

        .vehicle-layout-table tr:nth-child(odd) td:not(.vehicle-title) {
            background: #E2E2E2;
        }

        .vehicle-layout-table tr:nth-child(even) td:not(.vehicle-title) {
            background: #F8F8F8;
        }




        /*for print*/


        .loading-info {
            display: flex !important;
            flex-direction: row !important;
            justify-content: space-between !important;
            align-items: center !important;
            flex-wrap: nowrap !important;
            width: 100% !important;
        }

        .info-field,
        .status-field {
            display: flex !important;
            align-items: center !important;
            white-space: nowrap !important;
        }
</style>
<section role="main">
    <div class="loading-container print-area">
        <!-- ================= PRINT DOCUMENT HEADER ================= -->
        <div class="print-document-header">
            <div class="document-header-left">
                <span>Procedure No. : __________</span>
            </div>

            <div class="document-header-center">
                <span>Controlled Document</span>
            </div>

            <div class="document-header-right">
                <span>Rev No. : ______</span>
            </div>
        </div>

        <div id="loadingSheet">
            <!-- ================= HEADER ================= -->
            <div class="header-section">
                <div class="header-left">
                    <img src="~/Scripts/img/minda.jpg" style="height:70px;" />
                </div>
                <div class="header-center">
                    <h2 class="titleText">
                        MATERIAL LOADING SHEET
                    </h2>
                </div>
                <div class="header-right">
                    <button onclick="printLoadingSheet()" class="btn-print">
                        PRINT
                    </button>
                    <div class="dockBox">
                        <span>
                            DOCK NO
                        </span>
                        <span class="dockValue" id="DockNo">
                            @Model.DockNo
                        </span>
                    </div>
                </div>
            </div>
            <hr />
            <!-- ================= DATE TIME STATUS ================= -->
            <div class="loading-info">
                <div class="info-field">
                    <label>
                        Date :
                    </label>
                    <span id="currentDate"></span>
                </div>
                <div class="info-field">
                    <label>
                        Time :
                    </label>
                    <span id="currentTime"></span>
                </div>
                <div class="info-field">
                    <label>
                        Shift :
                    </label>
                    <span id="shiftName"></span>
                </div>
                <div class="status-field">
                    <label>Vehicle Loading Status :</label>
                    <span id="vehicleStatus" class="statusBox"></span>
                </div>
            </div>
            <hr />
            <!-- ================= LOADING DETAILS TABLE ================= -->
            <div class="table-scroll">
                <table class="loading-table">
                    <thead>
                        <tr>
                            <th>Sr No</th>
                            <th>Invoice No</th>
                            <th>Customer</th>
                            <th>Location</th>
                            <th>Part No</th>
                            <th>Part Description</th>
                            <th>SAP FG Code</th>
                            <th>Available Qty</th>
                            <th>Part Qty</th>
                            <th>FLC Qty</th>
                            <th>Vehicle Size</th>
                            <th>Vehicle No</th>
                            <th>Transporter</th>
                            <th>Loading Start Time</th>
                            <th>Loading End Time</th>
                            <th>Seal No</th>
                        </tr>
                    </thead>
                    <tbody id="loadingBody">
                        @if (Model.LoadingHistory != null)
                        {
                            int sr = 1;
                            foreach (var item in Model.LoadingHistory)
                            {
                                <tr>
                                    <td>
                                        @sr
                                    </td>
                                    <td> @item.InvoiceNo </td>
                                    <td> @item.Customer</td>
                                    <td> @item.Location </td>
                                    <td> @item.Model </td>
                                    <td> @item.Description</td>
                                    <td> @item.SAPFGCode</td>
                                    <td> @item.AvailableQty </td>
                                    <td> @item.EnteredQty </td>
                                    <td> @item.FLCQty </td>
                                    <td> @item.VehicleSize </td>
                                    <td> @item.VehicleRegNo </td>
                                    <td> @item.TransporterName</td>
                                    <td> @startTime.ToString("HH:mm:ss")</td>
                                    <td> @endTime.ToString("HH:mm:ss")</td>
                                    <td> @item.VehicleSealNo</td>
                                </tr>
                                sr++;
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr class="totalRow">
                            <td colspan="8">
                                TOTAL
                            </td>
                            <td id="totalQty">
                                0
                            </td>
                            <td id="totalFLC">
                                0
                            </td>
                            <td colspan="6">
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <!-- ================= VEHICLE LOADING LAYOUT ================= -->

            <div class="vehicle-section">

                <table id="vehicleGrid" class="vehicle-layout-table">
                </table>

            </div>
            <!-- ================= SIGNATURE AREA ================= -->
            <div class="bottom-section">
                <!-- SUPERVISOR -->
                <div class="person-box">
                    <table class="person-table">
                        <tr>
                            <td class="label-cell"> <b>Supervisor Name</b></td>
                            <td> @Model.SupervisiorName </td>
                        </tr>
                        <tr class="signature-row">
                            <td><b>Sign. of Supervisor</b> </td>
                            <td></td>
                        </tr>
                        <tr>
                            <td><b>Mobile Number</b></td>
                            <td> @Model.MobileNoSupervisor </td>
                        </tr>
                    </table>
                </div>
                <!-- DRIVER -->
                <div class="person-box">
                    <table class="person-table">
                        <tr>
                            <td class="label-cell"><b>Driver Name</b> </td>
                            <td> @Model.DriverName</td>
                        </tr>
                        <tr class="signature-row">
                            <td> <b>Sign. of Driver</b></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td><b>Mobile Number</b></td>
                            <td> @Model.MobileNoDriver </td>
                        </tr>
                    </table>
                </div>
                <!-- SECURITY -->
                <div class="person-box">
                    <table class="person-table">
                        <tr>
                            <td class="label-cell"> <b>Security Name</b></td>
                            <td> @Model.SecurityName </td>
                        </tr>
                        <tr class="signature-row">
                            <td> <b>Sign. of Security</b> </td>
                            <td></td>
                        </tr>
                        <tr>
                            <td><b>Mobile Number</b></td>
                            <td> @Model.MobileNoSecurity</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
        <!-- ================= PRINT DOCUMENT FOOTER ================= -->
        <div class="print-document-footer">
            <div>
                Record No. : __________
            </div>

            <div>
                Revision Date : __________
            </div>

            <div>
                Page : 1 of 1
            </div>
        </div>
    </div>

</section>
<script>

    $(document).ready(function () {
        updateDateTime();
        setInterval(updateDateTime, 1000);
        calculateTotal();
        createVehicleGrid();
        loadVehicleStatus();               // Initial load
        setInterval(loadVehicleStatus, 5000); // Refresh every 5 seconds
    });



    function updateShift() {
    $.ajax({
        url: '@Url.Action("GetCurrentShift", "Utility")',
        type: 'GET',
        success: function (response) {

            $('#shiftName').text(response);
        },
        error: function () {
            $('#shiftName').text('Shift unavailable');
        }
    });
}
    $(document).ready(function () {
        updateShift();
        setInterval(updateShift, 60000);
    });


    //================ DATE TIME SHIFT =================
    function updateDateTime() {
        let now = new Date();
        let date =
            now.toLocaleDateString('en-IN');
        let time =
            now.toLocaleTimeString('en-IN');
        $("#currentDate").text(date);
        $("#currentTime").text(time);
        let hour = now.getHours();
    }
    //================ TOTAL CALCULATION =================
    function calculateTotal() {
        let totalQty = 0;
        let totalFLC = 0;
        $("#loadingBody tr").each(function () {
            let qty =
                parseFloat($(this).find("td:eq(8)").text())
                || 0;
            let flc =
                parseFloat($(this).find("td:eq(9)").text())
                || 0;
            totalQty += qty;
            totalFLC += flc;
        });
        $("#totalQty").text(totalQty);
        $("#totalFLC").text(totalFLC);
    }
    //================ VEHICLE GRID =================


    let totalVehicleSlots = 0;
    function createVehicleGrid() {

        let vehicleSize = "";

        $("#loadingBody tr:first td").each(function (i) {
            if (i == 10)
                vehicleSize = $(this).text().trim();
        });

        totalVehicleSlots = (vehicleSize == "32") ? 36 : 28;

        let cols = totalVehicleSlots / 4;   //36=>9 columns, 28=>7 columns

        let html = "";

        for (let r = 0; r < 4; r++) {

            html += "<tr>";


            for (let c = 0; c < cols; c++) {

                let slot = 0;

                if (r == 0)
                    slot = totalVehicleSlots - 2 - (c * 4);

                if (r == 1)
                    slot = totalVehicleSlots - 3 - (c * 4);

                if (r == 2)
                    slot = totalVehicleSlots - (c * 4);

                if (r == 3)
                    slot = totalVehicleSlots - 1 - (c * 4);

                html += `<td data-slot="${slot}">${slot}</td>`;
            }


            if (r == 0) {

                html += `
            <td class="vehicle-title" rowspan="4">
                <div>Vehicle</div>
                <div>Loading</div>
                <div>Status</div>
            </td>`;
            }

            html += "</tr>";
        }

        $("#vehicleGrid").html(html);
    }



    // Create LH/RH grid

    function createSideGrid(element, count) {

        let html = "";
        let halfRow = count / 2;
        let odd = 1;
        let even = 2;
        // Odd row
        html += "<tr>";
        for (let i = 0; i < halfRow; i++) {
            html += `
        <td data-slot="${odd}">
            ${odd}
        </td>
        `;
            odd += 2;
        }
        html += "</tr>";



        // Even row

        html += "<tr>";
        for (let i = 0; i < halfRow; i++) {
            html += `
        <td data-slot="${even}">
            ${even}
        </td>
        `;
            even += 2;
        }

        html += "</tr>";



        $(element).html(html);

    }

    var dockNo = $("#DockNo").text().trim();
    function loadVehicleStatus() {

        if (!dockNo) {   // null, undefined, or empty string
            $("#vehicleStatus")
                .removeClass()
                .addClass("statusBox statusRed")
                .text("NOT YET STARTED");
            return;
        }


        $.get('GetVehicleLoadingStatus',
            {
                dockNo: dockNo
            },
            function (data) {
                if (data.Status == "R") {

                    $("#vehicleStatus")
                        .removeClass()
                        .addClass("statusBox statusRed")
                        .text("NOT YET STARTED");

                }
                else if (data.Status == "Y") {

                    $("#vehicleStatus")
                        .removeClass()
                        .addClass("statusBox statusYellow")
                        .text("IN PROCESS");

                }
                else if (data.Status == "G") {

                    $("#vehicleStatus")
                        .removeClass()
                        .addClass("statusBox statusGreen")
                        .text("COMPLETED");

                } else {
                    $("#vehicleStatus")
                        .removeClass()
                        .addClass("statusBox statusRed")
                        .text("NOT YET STARTED");


                }

                updateVehicleSlots(data.Status, data.ScannedCount);
            });

    }

    function updateVehicleSlots(status, scannedCount) {

        $("#vehicleGrid td[data-slot]").removeClass("filled");

        // NOT STARTED
        if (status == "R") {
            return;
        }

        // MATERIAL SCANNED
        if (status == "Y") {

            for (let i = 1; i <= scannedCount; i++) {
                $("#vehicleGrid td[data-slot='" + i + "']")
                    .addClass("filled");

            }
        }

        // COMPLETED
        if (status == "G") {

            $("#vehicleGrid td[data-slot]")
                .addClass("filled");

        }

    }

    //================ PRINT =================
    function printLoadingSheet() {
        window.print();
    }

</script>