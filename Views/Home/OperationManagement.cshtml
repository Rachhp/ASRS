
@using S1947.Models;
@{
    ViewBag.Title = "Material Management";
    Layout = "~/Views/Shared/_Layout.cshtml";

    S1947.Models.S1947Entities conn = new S1947.Models.S1947Entities();
    var userType = Session["UserType"]?.ToString() ?? "";
    var userName = Session["UserName"]?.ToString() ?? "";
    var UserNo = Session["Userid"];
    if (UserNo == null || (string)UserNo == "")
    {
        Response.Redirect("~/Home/Login");
    }
    var AdminMenuList = (from M in conn.Menulists select new { ModuleType = M.ModuleType }).Distinct().OrderByDescending(x => x.ModuleType).Distinct().ToList();

    int user = conn.UserMasters.Where(x => x.UserId == (string)UserNo).Select(x => x.MTransNo).FirstOrDefault();
    var UserData = conn.UserMasters.Where(x => x.UserId == (string)UserNo).FirstOrDefault();

    List<int> authorizedMasters = new List<int>();

    if (UserData.UserType != "ADMIN")
    {
        authorizedMasters = (from UA in conn.UserAuthorizations
                             join MO in conn.Menulists
                                 on UA.ModuleNo equals MO.MTransNo
                             where UA.UserNo == UserData.MTransNo
                                   && MO.ModuleType == "MASTERS"
                                   && UA.AuthType != null
                                   && UA.AuthType != ""
                             select MO.MTransNo).ToList();
    }
}

<style>
    .page-header {
        margin: -36px -37px 40px -37px;
        border-bottom: 5px solid #ff6a00;
    }
    .master {
        background: linear-gradient(135deg, #003366 0%, #001a33 100%);
        color: #fff;
        border-radius: 17px;
    }

    .card {
        width: 280px; /* Fixed width */
        height: 210px;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 30px 20px;
        border-radius: 18px;
        color: white;
        text-align: center !important;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
        border: 3px solid transparent;
        transition: transform 0.3s ease-out, box-shadow 0.3s ease-out, border-color 0.3s ease-out;
        min-height: 180px;
        position: relative;
        flex-direction: column;
        justify-content: center !important; /* Centers icon + title */
        align-items: center;
    }

    .card-icon ~ .card-title, .card-icon ~ .card-subtitle {
        margin-left: 0px;
    }

    .card:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
    }

    /* Icon Styling */
    .card-icon { /* Renamed class for clarity */
        font-size: 50px;
        margin-bottom: 20px;
        opacity: 0.9;
        transition: color 0.3s, transform 0.3s ease-out;
    }

    /* Animated Icon on Card Hover: Pulse effect */
    .card:hover .card-icon {
        animation: pulse 1.5s infinite; /* Subtle continuous pulse on hover */
    }

    @@keyframes pulse {
        0% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.05);
        }

        100% {
            transform: scale(1);
        }
    }

    /* Text Styling */
    .card-title {
        font-size: 22px;
        color: white;
        margin: 0 0 10px 0;
        font-weight: 600;
        line-height: 1.3;
        text-align: center !important;
    }

    /* --- Card Specific Colors and Glowing Border Effects --- */

    /* Card 1: Material Master (Warm Orange/Red) - Icon: cube/box */
    .card-1 {
        background: linear-gradient(135deg, #ff8c42, #ff3d00);
        /*box-shadow: 0 0 25px 8px rgba(255, 61, 0, 0.4);*/
        border-color: #ff3d00;
    }

        .card-1:hover {
            border-color: #ff8c42;
        }

    /* Card 2: Machine Master (Deep Violet/Magenta) - Icon: cogs/gear */
    .card-2 {
        background: linear-gradient(135deg, #8a2be2, #d81b60);
        /*box-shadow: 0 0 25px 8px rgba(138, 43, 226, 0.4);*/
        border-color: #8a2be2;
    }

        .card-2:hover {
            border-color: #d81b60;
        }

    /* Card 3:   Bin Allocation Master (Emerald Green/Teal) - Icon: warehouse/boxes */
    .card-3 {
        background: linear-gradient(135deg, #00c9b7, #008f82);
        /*box-shadow: 0 0 25px 8px rgba(0, 201, 183, 0.4);*/
        border-color: #00c9b7;
    }

        .card-3:hover {
