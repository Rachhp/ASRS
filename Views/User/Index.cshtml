@model S1947.Models.UserMasterValidation
@using S1947.Models
@{
    ViewBag.Title = "Index";
    S1947Entities conn = new S1947Entities();
    var data = conn.UserMasters.Where(s => s.UserName != null && s.DeleteStatus == "N" && s.UserId != "cautomate").ToList();
    Layout = "~/Views/Shared/_Layout.cshtml";
    var createdby = conn.UserMasters
                            .Select(e => e.MTransNo)
                            .Distinct()
                            .ToList();
}

<head>
    <link href="@Url.Content("~/Content/css/MaterialMaster.css")" rel="stylesheet" />
    <style>
        .form-section {
            display: flex;
        }

        .master {
            background: linear-gradient(135deg, #003366 0%, #001a33 100%);
            color: #fff;
            border-radius: 17px;
        }


        .page-header {
            margin: -36px -37px 40px -37px;
            border-bottom: 5px solid #ff6a00;
        }

        .table-responsive {
            max-height: 600px; /* set the max height for scrolling */
            overflow-y: auto; /* enable vertical scroll */
        }

        #datatable-tabletools thead th {
            position: sticky;
            top: 0;
            background-color: #003366; /* same as your header background */
            color: #fff;
            z-index: 10; /* make sure header stays on top */
        }

        .table-container {
            width: 100%;
        }

        .table-scroll {
            max-height: 600px; /* height of scrollable area */
            overflow-y: auto; /* vertical scrollbar */
            overflow-x: auto; /* horizontal scrollbar if table is wide */
            border: 1px solid #ccc; /* optional, to show boundary */
        }

        #datatable-tabletools thead th {
            position: sticky;
            top: 0;
            background-color: #003366;
            color: #fff;
            z-index: 10;
        }

    </style>
</head>

<section role="main">
    <header class="page-header d-flex justify-content-between align-items-center mb-4 p-3 shadow-sm" style="background: #1D2127; color: #fff;">
        <div>
            <h3 class="mb-4 font-weight-bold">
                <i class="fas fa-users-cog mr-2"></i> User Master
            </h3>
        </div>
        <div class="text-center flex-grow-1">
            <a href="~/User/AddEdit" class="btn btn-primary btn-lg px-4" style="border-radius: 30px;">
                <i class="fas fa-plus-circle mr-1"></i> Add New User
            </a>
        </div>
        <div>
            <ol class="breadcrumbs mb-0" style="list-style: none; padding-left: 0; display: flex; gap: 15px; font-size: 18px;">
                <li class="breadcrumb-item">
                    <a href="~/Home/Dashboard" style="color: #fff;">
                        <i class="fas fa-home"></i>
                    </a>
                </li>
                <li>
                    <a href="~/Home/MastersManagement"><i class="fas fa-sign-out-alt"></i></a>
                </li>
            </ol>
        </div>
    </header>
    <!-- Main Content -->
    <div class="card-modern">
        <div class="table-responsive">
            <input type="text" id="searchInput" class="form-control mb-2" placeholder="Search here..." />
            <table class="table table-bordered table-hover"id="datatable-tabletools">
                <thead>
                    <tr>
                        <th width="5%">SlNo</th>
                        <th width="25%">User Name</th>
                        <th width="15%">User ID</th>
                        <th width="15%">User Type</th>
                        <th width="20%">Mobile No</th>
                        <th width="20%">Email ID</th>
                        <th width="10%">Status</th>
                        <th width="10%">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @{
                        int row = 0;
                    }

                    @foreach (var item in data)
                    {
                        <tr>
                            <td class="text-center">@(++row)</td>
                            <td class="text-center">@item.UserName</td>
                            <td class="text-center">@item.UserId</td>
                            <td class="text-center">@item.UserType</td>
                            <td class="text-center">@item.ContactNo</td>
                            <td class="text-center">@item.EmailId</td>
                            <td class="text-center">
                                @if (item.LockStatus == "Y")
                                {
                                    <span class="badge badge-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">Inactive</span>
                                }
                            </td>
                            <td class="text-center">


                                @if (!createdby.Contains(item.MTransNo))
                                {
                                    <a href="javascript:void(0);" class="lock-icon" title="Already in stock" onclick="showLockMessage()">
                                        <i class="fas fa-lock text-muted"></i>
                                    </a>

                                }
                                else
                                {
                                    <a class="btn btn-primary btn-sm" href="AddEdit?MTransNo=@item.MTransNo" data-toggle="tooltip" title="Edit"> <i class="fas fa-edit"></i>  </a>

                                }

                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
<script>
    $(document).ready(function () {
        $("#searchInput").on("keyup", function () {
            var value = $(this).val().toLowerCase();
            $("table tbody tr").filter(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
            });
        });
    });
    function showLockMessage() {
        alert("Material Has Already Been Issued For This User, So It Cannot Be Updated.");
    }
</script>
