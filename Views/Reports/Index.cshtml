@{
    ViewBag.Title = "Reports";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .page-header {
        margin-top: 0 !important;
        margin: -36px -37px 40px -37px;
        border-bottom: 5px solid #ff6a00;
    }
    .content-body {
        padding-top: 0 !important;
    }

    .report-card {
        background: #fff;
        border-radius: 18px;
        padding: 35px 20px;
        text-align: center;
        height: 100%;
        border: 1px solid #e5e7eb;
        box-shadow: 0 8px 20px rgba(0,0,0,.08);
        transition: all .3s ease;
        position: relative;
        overflow: hidden;
    }

        .report-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 18px 35px rgba(0,0,0,.15);
        }

        .report-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 5px;
            background: linear-gradient(90deg,#0d6efd,#00b4ff);
        }

        /* Light Watermark Circle */
        .report-card::after {
            content: "";
            position: absolute;
            width: 120px;
            height: 120px;
            background: rgba(13,110,253,.05);
            border-radius: 50%;
            top: -35px;
            right: -35px;
        }

    .report-icon {
        width: 90px;
        height: 90px;
        margin: auto;
        border-radius: 24px;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 42px;
        color: white;
        margin-bottom: 25px;
        transition: .35s;
    }


    .report-card:hover .report-icon {
        transform: rotate(-8deg) scale(1.12);
    }
    .report-title {
        font-size: 24px;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 30px;
    }

    .report-desc {
        color: #6b7280;
        line-height: 1.7;
        min-height: 70px;
        margin-bottom: 22px;
    }

    .btn-report {
        border-radius: 30px;
        padding: 10px 28px;
        font-weight: 600;
    }

    .report-card:hover .report-icon {
        transform: rotate(-8deg) scale(1.1);
    }


    .report-card:hover .report-icon {
        transform: rotate(-8deg) scale(1.1);
    }

    .blue {
        background: linear-gradient(135deg,#3b82f6,#2563eb);
    }

    .orange {
        background: linear-gradient(135deg,#f59e0b,#ea580c);
    }

    .green {
        background: linear-gradient(135deg,#22c55e,#15803d);
    }

    .purple {
        background: linear-gradient(135deg,#8b5cf6,#6d28d9);
    }

    .red {
        background: linear-gradient(135deg,#ef4444,#dc2626);
    }
    .yellow {
        background: linear-gradient(135deg,#facc15,#ca8a04);
    }
    .maroon {
        background: linear-gradient(135deg,#800020,#5c0017);
    }
    .olive {
        background: linear-gradient(135deg,#6b8e23,#556b2f);
    }
    .brown {
        background: linear-gradient(135deg,#8b5e3c,#6f4e37);
    }

    .charcoal {
        background: linear-gradient(135deg,#4b5563,#1f2937);
    }

    .report-card.card-blue::before {
        background: linear-gradient(90deg,#3b82f6,#2563eb);
    }

    .report-card.card-orange::before {
        background: linear-gradient(90deg,#f59e0b,#ea580c);
    }

    .report-card.card-green::before {
        background: linear-gradient(90deg,#22c55e,#15803d);
    }

    .report-card.card-purple::before {
        background: linear-gradient(90deg,#8b5cf6,#6d28d9);
    }

    .report-card.card-red::before {
        background: linear-gradient(90deg,#ef4444,#dc2626);
    }
    .report-card.card-yellow::before {
        background: linear-gradient(90deg,#facc15,#eab308);
    }
    .report-card.card-maroon::before {
        background: linear-gradient(90deg,#800020,#5c0017);
    }

    .report-card.card-brown::before {
        background: linear-gradient(90deg,#8b5e3c,#6f4e37);
    }

    .report-card.card-charcoal::before {
        background: linear-gradient(90deg,#4b5563,#1f2937);
    }

    .report-card.card-olive::before {
        background: linear-gradient(90deg,#6b8e23,#556b2f);
    }
    .btn-blue {
        background: #2563eb;
        color: #fff;
        border: none;
    }

    .btn-orange {
        background: #ea580c;
        color: #fff;
        border: none;
    }

    .btn-green {
        background: #15803d;
        color: #fff;
        border: none;
    }

    .btn-purple {
        background: #6d28d9;
        color: #fff;
        border: none;
    }
    .report-card:hover {
        transform: translateY(-5px);
        transition: .3s;
    }
    .btn-maroon {
        background: #800020;
        color: #fff;
        border: none;
    }
 
    @@keyframes fadeUp {

    from {
        opacity: 0;
        transform: translateY(25px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

    .report-card {
        animation: fadeUp .6s ease;
    }
</style>

