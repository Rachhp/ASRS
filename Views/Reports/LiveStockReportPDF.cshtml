@model List<S1947.Models.LiveStockReportVM>

@{
    Layout = null;
    int sr = 1;
}

<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <title>Live Stock Report</title>

    <style>

        body {
            margin: 25px;
            font-family: Arial, Helvetica, sans-serif;
            font-size: 11px;
        }

        .report-title {
            text-align: center;
            font-size: 22px;
            font-weight: bold;
            margin-bottom: 5px;
        }

        .report-subtitle {
            text-align: center;
            font-size: 13px;
            color: #555;
            margin-bottom: 15px;
        }

        .report-info {
            width: 100%;
            margin-bottom: 15px;
            font-size: 11px;
        }

            .report-info td {
                border: none;
                padding: 3px;
            }

        .report-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

            .report-table th {
                background-color: #343a40;
                color: white;
                font-weight: bold;
                text-align: center;
            }

            .report-table th,
            .report-table td {
                border: 1px solid #999;
                padding: 6px;
                text-align: center;
                vertical-align: middle;
                word-wrap: break-word;
            }

            .report-table tbody tr:nth-child(even) {
                background-color: #f5f5f5;
            }

        thead {
            display: table-header-group;
        }

        tr {
            page-break-inside: avoid;
        }
    </style>

</head>

<body>

    <div class="report-title">
        Live Stock Report
    </div>

    <div class="report-subtitle">
        Current ASRS Loaded Stock
    </div>

    <table class="report-info">

        <tr>

            <td style="text-align:left;">
                <strong>Generated On :</strong>
                @DateTime.Now.ToString("dd-MMM-yyyy hh:mm tt")
            </td>

            <td style="text-align:right;">
                <strong>Total Records :</strong>
                @Model.Count
            </td>

        </tr>

    </table>

    <hr />

    <table class="report-table">

        <colgroup>

            <col style="width:5%;" />

            <col style="width:15%;" />

            <col style="width:15%;" />

            <col style="width:8%;" />

            <col style="width:8%;" />

            <col style="width:8%;" />

            <col style="width:8%;" />

            <col style="width:18%;" />

            <col style="width:15%;" />

        </colgroup>

        <thead>

            <tr>

                <th>Sr No</th>

                <th>Material Code</th>

                <th>Model</th>

                <th>Quantity</th>

                <th>Level</th>

                <th>Cell</th>

                <th>Depth</th>

                <th>Location</th>

                <th>Loaded Date</th>

            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model)
            {

                <tr>

                    <td>
                        @sr
                    </td>

                    <td>
                        @item.MaterialCode
                    </td>

                    <td>
                        @item.FGModel
                    </td>

                    <td>
                        @item.Quantity
                    </td>

                    <td>
                        @item.Level
                    </td>

                    <td>
                        @item.Cell
                    </td>

                    <td>
                        @item.Depth
                    </td>

                    <td>
                        @item.LocationName
                    </td>

                    <td>
                        @(item.LoadedDate.HasValue
                            ? item.LoadedDate.Value.ToString("dd-MM-yyyy HH:mm")
                            : "-")
                    </td>

                </tr>

                sr++;

            }

        </tbody>

    </table>

</body>

</html>
