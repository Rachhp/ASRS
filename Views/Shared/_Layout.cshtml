    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const sidebar =
                document.querySelector(".sidebar");
            const content =
                document.querySelector(".content-body");
            const toggleBtn =
                document.getElementById("sidebarToggle");
            if (localStorage.getItem("sidebarCollapsed") === "true") {
                sidebar.classList.add("collapsed");
                content.classList.add("expanded");
            }
            toggleBtn.addEventListener("click", function () {
                sidebar.classList.toggle("collapsed");
                content.classList.toggle("expanded");
                localStorage.setItem(
                    "sidebarCollapsed",
                    sidebar.classList.contains("collapsed")
                );
            });
        });
    </script>
    <script>
        function pNof(til, txt) {
            new PNotify({
                title: til,
                text: txt,
                shadow: true,
                addclass: 'stack-topright'
            });
        }
        function pNofsuc(til, txt) {
            new PNotify({
                title: til,
                text: txt,
                type: 'success',
                shadow: true,
                addclass: 'stack-topright'
            });
        }
        function pNoffail(til, txt) {
            new PNotify({
                title: til,
                text: txt,
                type: 'error',
                shadow: true,
                addclass: 'stack-topright'
            });
        }
        function voiceMsg(voice_msg) {
            var msg =
                new SpeechSynthesisUtterance(voice_msg);
            var voices =
                window.speechSynthesis.getVoices();
            msg.voice =
                voices.find(
                    voice => voice.name === "Google US English"
                );
            window.speechSynthesis.speak(msg);
        }
        window.speechSynthesis.onvoiceschanged = function () {
            window.speechSynthesis.getVoices();
        };
        function showMessage(message) {
            var messageContainer =
                document.createElement("div");
            messageContainer.style.position = "fixed";
            messageContainer.style.top = "20%";
            messageContainer.style.right = "20px";
            messageContainer.style.transform =
                "translateY(-50%)";
            messageContainer.style.zIndex = "9999";
            var messageDiv =
                document.createElement("div");
            messageDiv.textContent = message;
            messageDiv.style.backgroundColor =
                "rgba(255, 0, 0, 0.7)";
            messageDiv.style.color = "white";
            messageDiv.style.padding = "10px";
            messageDiv.style.borderRadius = "5px";
            messageDiv.style.boxShadow =
                "0px 0px 5px rgba(0, 0, 0, 0.5)";
            messageContainer.appendChild(messageDiv);
            document.body.appendChild(messageContainer);
            setTimeout(function () {
                document.body.removeChild(messageContainer);
            }, 5000);
        }
        function addTempMessage(element, message) {
            $('.temp-message').remove();
            var tempMessage =
                $('<div>')
                    .text(message)
                    .addClass('temp-message');
            element.after(tempMessage);
            setTimeout(function () {
                tempMessage.remove();
            }, 3000);
        }
        function showHeaderMessage(message, type) {
            const header =
                document.getElementById('drawerMessage');
            header.textContent = message;
            header.style.display = "block";
            switch (type) {
                case "success":
                    header.style.color = "green";
                    break;
                case "error":
                    header.style.color = "red";
                    break;
                case "warning":
                    header.style.color = "orange";
                    break;
                default:
                    header.style.color = "black";
            }
            header.style.display = "block";
        }
        let linkClickHandlers = [];
        let formSubmitHandlers = [];
        let navBlocked = false;
        /* ================= BLOCK ================= */
        function blockNav() {
            navBlocked = true;
            document.addEventListener(
                'keydown',
                blockRefresh
            );
            history.pushState(
                null,
                null,
                location.href
            );
            window.addEventListener(
                'popstate',
                blockBack
            );
            document.querySelectorAll('a').forEach(a => {
                a.addEventListener(
                    'click',
                    blockAnchors,
                    true
                );
            });
            document.querySelectorAll('.menu-item').forEach(item => {
                item.addEventListener(
                    'click',
                    blockSidebar,
                    true
                );
            });
        }
        /* ================= UNBLOCK ================= */
        function unblockNav() {
            navBlocked = false;
            document.removeEventListener(
                'keydown',
                blockRefresh
            );
            window.removeEventListener(
                'popstate',
                blockBack
            );
            document.querySelectorAll('a').forEach(a => {
                a.removeEventListener(
                    'click',
                    blockAnchors,
                    true
                );
            });
            document.querySelectorAll('.menu-item').forEach(item => {
                item.removeEventListener(
                    'click',
                    blockSidebar,
                    true
                );
            });
        }
        /* ================= HANDLERS ================= */
        function blockAnchors(e) {
            if (navBlocked) {
                e.preventDefault();
                e.stopImmediatePropagation();
            }
        }
        function blockSidebar(e) {
            if (navBlocked) {
                e.preventDefault();
                e.stopImmediatePropagation();
            }
        }
        function blockRefresh(e) {
            if (
                e.key === 'F5' ||
                (e.ctrlKey &&
                    e.key.toLowerCase() === 'r')
            ) {
                e.preventDefault();
            }
        }
        function blockBack() {
            history.pushState(
                null,
                null,
                location.href
            );
        }
        function showCustomToast(message) {
            $('#customToast')
                .text(message)
                .stop(true, true)
                .fadeIn(300)
                .delay(4000)
                .fadeOut(400);
        }
        function showCustomToast1(message) {
            $('#customToast1')
                .text(message)
                .stop(true, true)
                .fadeIn(300)
                .delay(4000)
                .fadeOut(400);
        }
    </script>
