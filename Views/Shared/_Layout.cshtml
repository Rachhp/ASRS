@RenderSection("scripts", required: false)
@using S1947.Models;
@{
    S1947.Models.S1947Entities conn = new S1947.Models.S1947Entities();
    var userType = Session["UserType"]?.ToString() ?? "";
    var userName = Session["UserName"]?.ToString() ?? "";
    var UserNo = Session["Userid"];
    if (UserNo == null || (string)UserNo == "")
    {
        Response.Redirect("~/Home/Login");
    }
    var AdminMenuList = (from M in conn.Menulists
                         select new
                         {
                             ModuleType = M.ModuleType
                         }).Distinct().OrderByDescending(x => x.ModuleType).Distinct().ToList();


    int user = conn.UserMasters.Where(x => x.UserId == (string)UserNo).Select(x => x.MTransNo).FirstOrDefault();
    var UserData = conn.UserMasters.Where(x => x.UserId == (string)UserNo).FirstOrDefault();

    bool isAdmin = UserData.UserType.Equals("ADMIN", StringComparison.OrdinalIgnoreCase);
    bool isOperator = UserData.UserType.Equals("OPERATOR", StringComparison.OrdinalIgnoreCase);

}
