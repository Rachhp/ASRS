    <script>
        const body = document.body;
        const themeToggle = document.getElementById('theme-toggle');
        const themeKey = 'isDarkMode';

        function setDark(isDark) {
            if (isDark) {
                body.classList.add('dark-mode');
                themeToggle.checked = true;
            } else {
                body.classList.remove('dark-mode');
                themeToggle.checked = false;
            }
            localStorage.setItem(themeKey, isDark ? 'true' : 'false');
            updateChartTheme(); // optional: for charts
        }

        themeToggle.addEventListener('change', () => {
            setDark(themeToggle.checked);
        });

        window.addEventListener('DOMContentLoaded', () => {
            // Apply saved theme
            const storedTheme = localStorage.getItem(themeKey) === 'true';
            setDark(storedTheme);

            // Initialize charts or other UI
            if (typeof initCharts === 'function') initCharts();
        });

        function updateChartTheme() {
            if (typeof getChartColors !== 'function') return;
            const colors = getChartColors();

            if (typeof costChart !== 'undefined' && costChart) {
                costChart.options.plugins.legend.labels.color = colors.textColor;
                costChart.options.scales.x.ticks.color = colors.textColor;
                costChart.options.scales.y.ticks.color = colors.textColor;
                costChart.options.scales.y.grid.color = colors.gridColor;
                costChart.update();
            }

            if (typeof issueReturnChart !== 'undefined' && issueReturnChart) {
                issueReturnChart.options.plugins.legend.labels.color = colors.textColor;
                issueReturnChart.update();
            }
        }
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const sidebar = document.querySelector(".sidebar");
            const content = document.querySelector(".content-body");
            const toggleBtn = document.getElementById("sidebarToggle");

            if (localStorage.getItem("sidebarCollapsed") === "true") {
                sidebar.classList.add("collapsed");
                content.classList.add("expanded");
            }

            toggleBtn.addEventListener("click", function () {

                sidebar.classList.toggle("collapsed");
                content.classList.toggle("expanded");

                localStorage.setItem(
                    "sidebarCollapsed",
                    sidebar.classList.contains("collapsed")
                );
            });
        });
    </script>


    <script>
        function pNof(til, txt) {
            new PNotify({
                title: til,
                text: txt,
                shadow: true,
                addclass: 'stack-topright'
            });
        }

        //Success notify method
        function pNofsuc(til, txt) {
            new PNotify({
                title: til,
                text: txt,
                type: 'success',
                shadow: true,
                addclass: 'stack-topright'
            });
        }
        //Fail notify method
        function pNoffail(til, txt) {
            new PNotify({
                title: til,
                text: txt,
                type: 'error',
                shadow: true,
                addclass: 'stack-topright'
            });
        }

        function voiceMsg(voice_msg) {
            var msg = new SpeechSynthesisUtterance(voice_msg);

            // Get available voices (this may take time to load)
            var voices = window.speechSynthesis.getVoices();

            // Pick a specific voice by name (example: "Google US English")
            msg.voice = voices.find(voice => voice.name === "Google US English");

            window.speechSynthesis.speak(msg);
        }

        // Ensure voices are loaded before use
        window.speechSynthesis.onvoiceschanged = function () {
            // Call once to preload voices
            window.speechSynthesis.getVoices();
        };
        function showMessage(message) {
            // Create a div element for the message container
            var messageContainer = document.createElement("div");

            // Set styles for the message container
            messageContainer.style.position = "fixed";
            messageContainer.style.top = "20%";
            messageContainer.style.right = "20px"; // Adjust this value as needed
            messageContainer.style.transform = "translateY(-50%)";
            messageContainer.style.zIndex = "9999"; // Ensure the message appears above other content

            // Create a div element for the message text
            var messageDiv = document.createElement("div");

            // Set the message text
            messageDiv.textContent = message;

            // Optionally, you can style the message text
            messageDiv.style.backgroundColor = "rgba(255, 0, 0, 0.7)"; // Red with some transparency
            messageDiv.style.color = "white";
            messageDiv.style.padding = "10px";
            messageDiv.style.borderRadius = "5px"; // Rounded corners
            messageDiv.style.boxShadow = "0px 0px 5px rgba(0, 0, 0, 0.5)"; // Shadow effect

            // Append the message text to the container
            messageContainer.appendChild(messageDiv);

            // Append the container to the body
            document.body.appendChild(messageContainer);

            // Set a timeout to remove the message after 5 seconds (adjust the duration as needed)
            setTimeout(function () {
                document.body.removeChild(messageContainer);
            }, 5000); // 5000 milliseconds = 5 seconds
        }

        function addTempMessage(element, message) {
            // Remove any existing temporary messages
            $('.temp-message').remove();

            // Create temporary message element next to the target element
            var tempMessage = $('<div>').text(message).addClass('temp-message');
            element.after(tempMessage);

            // Remove temporary message after 3 seconds
            setTimeout(function () {
                tempMessage.remove();
            }, 3000);
        }

        function showHeaderMessage(message, type) {
            const header = document.getElementById('drawerMessage');
            header.textContent = message;
            header.style.display = "block";
            // Optionally style based on type
            switch (type) {
                case "success":
                    header.style.color = "green";
                    break;
                case "error":
                    header.style.color = "red";
                    break;
                case "warning":
                    header.style.color = "orange";
                    break;
                default:
                    header.style.color = "black";
            }

            header.style.display = "block";
        }


        let linkClickHandlers = [];
        let formSubmitHandlers = [];

       


        let navBlocked = false;

        /* ================= BLOCK ================= */

        function blockNav() {
            navBlocked = true;

            // Block refresh
            document.addEventListener('keydown', blockRefresh);

            // Block back/forward
            history.pushState(null, null, location.href);
            window.addEventListener('popstate', blockBack);

            // Block all anchor tags (Home icon)
            document.querySelectorAll('a').forEach(a => {
                a.addEventListener('click', blockAnchors, true);
            });

            // Block sidebar menu items
            document.querySelectorAll('.menu-item').forEach(item => {
                item.addEventListener('click', blockSidebar, true);
            });
        }

        /* ================= UNBLOCK ================= */

        function unblockNav() {
            navBlocked = false;

            document.removeEventListener('keydown', blockRefresh);
            window.removeEventListener('popstate', blockBack);

            document.querySelectorAll('a').forEach(a => {
                a.removeEventListener('click', blockAnchors, true);
            });

            document.querySelectorAll('.menu-item').forEach(item => {
                item.removeEventListener('click', blockSidebar, true);
            });
        }

        /* ================= HANDLERS ================= */

        function blockAnchors(e) {
            if (navBlocked) {
                e.preventDefault();
                e.stopImmediatePropagation();
            }
        }

        function blockSidebar(e) {
            if (navBlocked) {
                e.preventDefault();
                e.stopImmediatePropagation();
            }
        }

        function blockRefresh(e) {
            if (e.key === 'F5' || (e.ctrlKey && e.key.toLowerCase() === 'r')) {
                e.preventDefault();
            }
        }

        function blockBack() {
            history.pushState(null, null, location.href);
        }



        function showCustomToast(message) {
            $('#customToast').text(message).stop(true, true).fadeIn(300).delay(4000).fadeOut(400);
        }
        function showCustomToast1(message) {
            $('#customToast1').text(message).stop(true, true).fadeIn(300).delay(4000).fadeOut(400);
        }
       

    </script>

