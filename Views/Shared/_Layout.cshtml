@using S1947.Models;
@{
    S1947Entities conn = new S1947Entities();
    var userId = Session["Userid"]?.ToString() ?? "";
    var userType = Session["UserType"]?.ToString() ?? "";
    var userName = Session["UserName"]?.ToString() ?? "";
    var currentUser = conn.UserMasters
        .FirstOrDefault(x => x.UserId == userId);
    List<int> authorizedModuleNos = new List<int>();
    if (currentUser != null)
    {
        if (currentUser.UserType.Equals("ADMIN", StringComparison.OrdinalIgnoreCase))
        {
            // ADMIN = all modules
            authorizedModuleNos = conn.Menulists
                .Select(x => x.MTransNo)
                .ToList();
        }
        else
        {
            // NON-ADMIN = only authorized modules
            authorizedModuleNos = (
                from UA in conn.UserAuthorizations
                join ML in conn.Menulists
                    on UA.ModuleNo equals ML.MTransNo
                where UA.UserNo == currentUser.MTransNo
                      && UA.AuthType != null
                      && UA.AuthType != ""
                      && UA.AuthType != "N"
                select ML.MTransNo
            )
            .Distinct()
            .ToList();
        }
    }
    var modulesList = conn.Menulists
        .Where(x => authorizedModuleNos.Contains(x.MTransNo))
        .Select(x => new
        {
            x.ModuleType,
            x.ModuleName,
            x.ModulePage,
            x.ModuleLink,
            x.MTransNo
        })
        .ToList();
    /*
        Check whether the user has at least one module in each category.
    */
    bool hasMasterAccess = modulesList.Any(x =>
        x.ModuleType == "MASTERS");
    bool hasOperationAccess = modulesList.Any(x =>
        x.ModuleType == "OPERATIONS");
    bool hasReportAccess = modulesList.Any(x =>
        x.ModuleType == "REPORTS");
    bool isAdmin = currentUser != null &&
                   currentUser.UserType.Equals("ADMIN", StringComparison.OrdinalIgnoreCase);
    bool isOperator = currentUser != null &&
                      currentUser.UserType.Equals("OPERATOR", StringComparison.OrdinalIgnoreCase);
    bool isNotCautomate = !userName.Equals(
        "cautomate",
        StringComparison.OrdinalIgnoreCase
    );
}
