                </div>

                <div class="menu-item dark-mode-item" hidden>
                    <span>Dark Mode</span>
                    <div class="theme-switch">
                        <input type="checkbox" id="theme-toggle" aria-label="Toggle dark mode">
                        <label for="theme-toggle" class="toggle-label">
                            <i class="fa-solid fa-sun sun"></i>
                            <i class="fa-solid fa-moon moon"></i>
                            <span class="slider"></span>
                        </label>
                    </div>
                </div>

                @{
                    // Fetch all modules for current user
                    var modulesList = (from MO in conn.Menulists
                                       select new
                                       {
                                           MO.ModuleType,
                                           MO.ModuleName,
                                           MO.ModulePage,
                                           MO.ModuleLink,
                                           MO.MTransNo
                                       }).ToList();

                    if (UserData.UserType != "ADMIN")
                    {
                        modulesList = (from UA in conn.UserAuthorizations
                                       join MO in conn.Menulists
                                       on UA.ModuleNo equals MO.MTransNo
                                       where UA.UserNo == UserData.MTransNo && UA.AuthType != "N"
                                       select new
                                       {
                                           MO.ModuleType,
                                           MO.ModuleName,
                                           MO.ModulePage,
                                           MO.ModuleLink,
                                           MO.MTransNo
                                       }).ToList();
                    }

                    bool isNotCautomate = userName != "cautomate";
                }

                @if (isNotCautomate)
                {
                    <!-- Dashboard (always visible) -->
                    <div class="menu-item dashboard" onclick="location.href='/Home/Dashboard'">
                        <i class="fa-solid fa-house"></i><span>Dashboard</span>
                    </div>
                    // ==========================
                    // ADMIN
                    // ==========================
                    if (isAdmin)
                    {

                        if (modulesList.Any(m => m.ModuleType == "MASTERS"))
                        {
                            <div class="menu-item master" onclick="location.href='/Home/MastersManagement'">
                                <i class="fa-solid fa-angles-right"></i><span>Masters</span>
                            </div>
                        }
                        <!-- Masters -->
                        if (modulesList.Any(m => m.ModuleType == "OPERATIONS"))
                        {
                            <div class="menu-item operation" onclick="location.href='/Home/operationManagement'">
                                <i class="fa-solid fa-box"></i><span>Operations</span>
                            </div>
                        }
                        <!-- Operations -->
                        if (modulesList.Any(m => m.ModuleType == "REPORTS"))
                        {
                            <div class="menu-item operation" onclick="location.href='/reports/Index'">
                                <i class="fa-solid fa-adjust"></i> <span>Reports</span>
                            </div>
                        }

                        if (userName != "cautomate")
                        {
                            <div class="menu-item liveStock"
                                 onclick="location.href='/Andon/AndonScreen'">
                                <i class="fas fa-boxes"></i>
                                <span>Display Screen</span>
                            </div>
                        }
                    }
                    // ==========================
                    // OPERATOR
                    // ==========================
                    else if (isOperator)
                    {
                        <div class="menu-item operation" onclick="location.href='/Home/operationManagement'">
                            <i class="fa-solid fa-box"></i>
                            <span>Operations</span>
                        </div>

                        <div class="menu-item operation" onclick="location.href='/reports/Index'">
                            <i class="fa-solid fa-adjust"></i>
                            <span>Reports</span>
                        </div>
                    }

                    <!-- Logout (always visible) -->
