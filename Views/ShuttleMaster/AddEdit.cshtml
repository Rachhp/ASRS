<section role="main" >
    <form id="FRM" method="POST" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <header class="page-header d-flex justify-content-between align-items-center mb-4 p-3 shadow-sm" style="background: #000; color: #fff; ">
            <h3 class="mb-4 font-weight-bold" style="color:aliceblue">
                <i class="fas fa-box-open"></i>  Shuttle Master
            </h3>
            <div class="right-wrapper">
                <ol class="breadcrumbs mb-0" style="list-style: none; padding-left: 15px; display: flex; gap: 5px; font-size: 18px;">
                    <li class="breadcrumb-item">
                        <a href="~/Home/Dashboard" style="color: #fff;">
                            <i class="fas fa-home"></i>
                        </a>
                    </li>
                    <li>
                        <a href="~/Home/MaterialManagement"><i class="fas fa-sign-out-alt"></i></a>
                    </li>
                </ol>
            </div>
        </header>
        <div class="row">
            <div class="col-12">
                <section class="card form-card shadow-sm">
                    @*<div class="card-body">*@
                    <div id="customToast1" class="custom-toast1"></div>
                    <div id="customToast" class="custom-toast"></div>
                    <div class="loader" style="display:none;">Loading<span></span> </div>
                    <div class="form-group row">
                        <label class="col-lg-2 col-form-label text-lg-right"><span class="required">*</span>Shuttle Number</label>
                        <div class="col-lg-4">
                            @Html.HiddenFor(m => m.MTransNo)
                            @*@Html.DropDownListFor(m => m.ShuttleNo, null, "-- Select Shuttle Number --", new { @class = "form-control input-box" })*@
                            @Html.TextBoxFor(m => m.ShuttleNo, new { @class = "form-control input-box", @readonly = "readonly" })
                            @Html.ValidationMessageFor(m => m.ShuttleNo, "", new { @class = "error" })

                        </div>
                    </div>
                    <div class="form-group row">
                        <label class="col-lg-2 col-form-label text-lg-right"><span class="required">*</span>Status</label>
                        <div class="col-lg-4">

                            @* @Html.DropDownListFor(m => m.LockStatus, (IEnumerable<SelectListItem>)ViewBag.LockStatus, "-- Select Lock Status --", new { @class = "form-control" })*@
                            @*@Html.DropDownListFor(m => m.LockStatus, (SelectList)ViewBag.lockstatus, new { @class = "form-control input-box" })*@
                            @Html.DropDownListFor(
    m => m.LockStatus,
    (SelectList)ViewBag.lockstatus,
    "-- Select Status --",
    new { @class = "form-control input-box", id = "LockStatus" }
)
                            @Html.ValidationMessageFor(m => m.LockStatus, "", new { @class = "error" })
                        </div>
                    </div>
                    <br />
                    <div class="text-center mt-4">
                        <div class="text-center button-group">
                            <button type="submit" id="MainSubmit" class="theme-btn btn-orange">Save</button>
                            <button type="button" class="theme-btn btn-black" onclick="history.back();"> Cancel </button>
                        </div>
                    </div>
                    @*</div>*@
                </section>
                <hr />
                <div class="table-responsive mt-4">
                    <table class="table table-bordered table-striped">
                        <thead style="background:#003366;color:white;">
                            <tr>
                                <th>Shuttle No</th>
                                <th>Status</th>
                                <th width="100">Action</th>
                            </tr>

                        </thead>
                        <tbody>
                            @foreach (var item in ViewBag.ShuttleList)
                            {
                                <tr>
                                    <td>@item.ShuttleNo</td>
                                    <td>
                                        @(item.LockStatus == "Y" ? "Active" : "Inactive")
                                    </td>
                                    <td>
                                        <a href="@Url.Action("AddEdit","ShuttleMaster", new { MTransNo = item.MTransNo })" class="btn btn-primary btn-sm"> Edit </a>
                                    </td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </form>
</section>

@if (TempData["Message"] != null)
{
    <script>
        alert('@TempData["Message"]');
    </script>
}

<script>
    $(document).ready(function () {
    var val = '@Model.LockStatus';
    $("#LockStatus").val(val);
});
    $(document).ready(function () {

    $("#MainSubmit").click(function (e) {
      e.preventDefault();
      $('#loader').show();
      // Get field values

      var MTransNo = $("#MTransNo").val();
      var status = $("#LockStatus").val();

       if (MTransNo == "" || MTransNo == null || MTransNo == 0) {
          //alert("⚠️ Please enter Material Code");
          $('#customToast').text("⚠️ Please Select Shuttle Number", "").stop(true, true).fadeIn(300).delay(4000).fadeOut(400);
          $("#MaterialCode").focus();
          return;
      }
      if (status === "" || status === null) {
          showCustomToast("⚠️ Please Select Status");
          $("#LockStatus").focus();
          return;
      }

      if ($("#MainSubmit").data("clicked")) return;
      $("#MainSubmit").data("clicked", true);
      $("#MainSubmit").prop("disabled", true);
      $.ajax({
          url: '@Url.Action("SaveData", "ShuttleMaster")',
          type: 'POST',
          data: {
              MTransNo: MTransNo,
              status: status
          },
          success: function (response) {
              showCustomToast1(response.message);
              $('#loader').hide();

              if (response.success) {
                  setTimeout(function () { window.location.href = '@Url.Action("AddEdit", "ShuttleMaster")'; }, 1500); }
              },
              error: function (xhr) {
                  $('#loader').hide();
                  $("#MainSubmit").prop("disabled", false).data("clicked", false);
              var msg = "❌ Something Went Wrong! Please Try Again.";
              if (xhr.responseJSON && xhr.responseJSON.message) {
                  msg = xhr.responseJSON.message;
                  }

                  showCustomToast(msg);
                  ClearForm()
          }
      });

      function showCustomToast(message) {
          $('#customToast').text(message).stop(true, true).fadeIn(300).delay(4000).fadeOut(400);
      }
      function showCustomToast1(message) {
          $('#customToast1').text(message).stop(true, true).fadeIn(300).delay(4000).fadeOut(400);
      }

  });
});


    function ClearForm() {
        // Text fields

        $("#ShuttleNo").prop('selectedIndex', 0);
        $("#LockStatus").prop('selectedIndex', 0);

        // Clear MVC validation messages
        $(".error").text('');
    }
</script>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
