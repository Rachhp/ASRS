@model S1947.Models.UnloadValidation
@{
    ViewBag.Title = "Security Loading";
    Layout = "~/Views/Shared/_Layout.cshtml";

    //string invoiceNo = ViewBag.InvoiceNo ?? "-";
    //string customer = ViewBag.CustomerName ?? "-";

    int expected = ViewBag.ExpectedFLC ?? 0;
    int scanned = ViewBag.ScannedFLC ?? 0;

    int remaining = expected - scanned;

    if (remaining < 0)
    {
        remaining = 0;
    }

    int percentage = expected == 0 ? 0 : (scanned * 100 / expected);
}

<script src="~/Scripts/jquery-3.3.1.js"></script>

