</section>

@*</div>*@

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

<script>


    function loadInvoiceDetails() {
        $("#txtQR").prop("disabled", false);
        var dockNo = $("#DockList").val();

        if (!dockNo)
            return;

        $.getJSON('/Unload/GetInvoiceDetails',
            {
                dockNo: dockNo
            },
            function (res) {

                $("#CustomerName").val(res.customer);
                $("#VehicleNumber").val(res.vehicleNumber);
                $("#VehicleSize").val(res.vehicleSize);

                $("#lblExpected").text(res.expected);
                $("#lblScanned").text(res.scanned);
                var percent = res.expected == 0
                    ? 0
                    : Math.round((res.scanned * 100) / res.expected);

                $("#progressBar")
                    .css("width", percent + "%")
                    .text(percent + "%");

                var tbody = $("#tblBody");

                tbody.empty();

                if (res.pallet) {

                    tbody.append(`
                <tr>
                    <td>${res.pallet.PalletQR}</td>
                    <td>${res.pallet.PalletNo}</td>
                    <td>${res.pallet.SAPFGCode}</td>
                    <td>${res.pallet.TotalQty}</td>
                    <td>
                        <span class="badge badge-warning">
                            ⏳ PENDING
                        </span>
                    </td>
                </tr>
            `);

                } else {

                    tbody.append(`
                            <tr>
                                <td colspan="5" class="text-center">
                                    Loading Completed
                                </td>
                            </tr>
                        `);

                    $("#txtQR").prop("disabled", true);
                }
            });
    }


    $("#DockList").change(function () {

        $("#CustomerName").val("");
        $("#VehicleNumber").val("");
        $("#VehicleSize").val("");

        $("#lblExpected").text("0");
        $("#lblScanned").text("0");
        $("#tblBody").empty();

        if ($(this).val() != "") {
            loadInvoiceDetails();

            setTimeout(function () {
                $("#txtQR").focus();
            }, 200);
        }
    });

    ///just call the function
    $("#InvoiceList").change(function () {

        loadInvoiceDetails();
        setTimeout(function () {
            $("#txtQR").focus();
        }, 200);
    });

    $("#txtQR").on("keypress", function (e) {

        if (e.which === 13) {
            e.preventDefault();
            scanPallet();
        }

    });

    function keepFocus() {
        if (!$("#txtQR").prop("disabled")) {
            setTimeout(function () {
                $("#txtQR").focus();
            }, 100);
        }
    }

    function scanPallet() {
        if ($("#DockList").val() == "") {
            showToastMessage("Please select Dock.", "warning");
            $("#DockList").focus();
            return;
        }

        if ($("#InvoiceList").val() == "") {
            showToastMessage("Please select Invoice.", "warning");
            $("#InvoiceList").focus();
            return;
        }

        var qr = $("#txtQR").val().trim();

        if (qr == "") {
            showToastMessage("Please scan Pallet QR.", "warning");
            $("#txtQR").focus();
            return;
        }

        $.ajax({

            url: "/Unload/ScanPallet",
            type: "POST",
            data: {
                qrCode: qr,
                dockNo: $("#DockList").val().trim()

            },

            success: function (res) {
                if (res.success) {

                    if (res.completed) {
                        showToastMessage("🎉 All pallets scanned successfully. Loading Completed.", "success");
                    } else {
                        showToastMessage(
                            "Pallet scanned successfully.<br><b>Next Pallet: " + res.pallet.PalletNo + "</b>",
                            "success"
                        );
                    }
                } else {
                    showToastMessage(res.message, "warning"
                    );
                }
                loadInvoiceDetails();
                $("#txtQR").val("");
                keepFocus();
            }
        });

    }


</script>
