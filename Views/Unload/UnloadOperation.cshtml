    function AddTable(result) {

        let event_data = '';
        //    // allowDelete logic
        let LoadInProcess = result.some(x => x.Status === "In Process" || x.Status === "Completed" || x.Status === "Vehicle Picked" || x.Status ==="Task Assigned");
        $('#myTable tbody').empty();

        for (let i = 0; i < result.length; i++) {

            let item = result[i];
            let k = i + 1;

            let statusClass = '';

            switch (item.Status) {

                case 'Task Assigned':
                    statusClass = 'badge-secondary';
                    break;

                case 'Vehicle Picked':
                    statusClass = 'badge-primary';
                    break;

                case 'In Process':
                    statusClass = 'badge-warning';
                    break;

                case 'Completed':
                    statusClass = 'badge-success';
                    break;

                default:
                    statusClass = 'badge-dark';
                    break;
            }

            event_data += `<tr>`;
            event_data += `<td class="text-center">${k}</td>`;

            event_data += `
            <td>
                ${item.InvoiceNo} -
                ${item.CustomerName}
            </td>`;
            event_data += `
            <td>
                ${item.LocationofDelivery} -
                ${item.TransporterName}
            </td>`;
            event_data += `
            <td>
                ${item.VehicleNumber} -
                ${item.VehicleSealNo}
            </td>`;
            event_data += `
             <td>
                 ${item.VehicleSize} -
                 ${item.FLCLocation}
             </td>`;

            event_data += `
            <td>
                ${item.SupervisiorName} -
                ${item.MobileNoSupervisor}
            </td>`;

             event_data += `
            <td>
                ${item.DriverName} -
                ${item.MobileNoDriver}
            </td>`;

             event_data += `
            <td>
                ${item.SecurityName} -
                ${item.MobileNoSecurity}
            </td>`;
            event_data += `
                <td>
                ${item.SAPFGCode}-
                ${item.FGModel} 
            </td>`;
            event_data += `
            <td>
                ${item.DockNo} -
                ${item.FGModelDesc}

            </td>`;

            event_data += `
            <td>
                Q: ${item.PartQuantity}
            </td>`;

            // Status Column
            event_data += `
            <td>
                <span class="badge ${statusClass}" id="status">
                    ${item.Status}
                </span>
            </td>`;

            // Action Logic
            if (item.Status === "Added" && !LoadInProcess) {
                        event_data += `
                        <td class="text-center">
                            <button class="btn btn-danger btn-xs" onclick="deleteItem('${item.MTransNo}')">
                                <i class="far fa-trash-alt"></i>
                            </button>
                        </td>`;
                    } else {
                        event_data += `
                        <td class="text-center">
                            <button class="btn btn-secondary btn-xs" disabled>
                                <i class="fas fa-ban"></i>
                            </button>
                        </td>`;
                    }
                    event_data += `</tr>`;
        }

        $('#myTable tbody').append(event_data);
    }

    function deleteItem(mTransNo) {
    if (confirm("Are you sure you want to delete this record?")) {
        $.ajax({
            type: "POST",
            url: "@Url.Action("DeleteUnloadEntry", "Unload")",
            data: { id: mTransNo },
            success: function (res) {
                if (res.success) {
                    showToastMessage(res.message, "success");

                } else {
                    alert("Error: " + res.message);
                    showToastMessage(res.message, "error");
                }
            },
            error: function () {
                alert("An error occurred while deleting the entry.");
            }
        });
    }
    }


   // setInterval(AutoUpdateStatus, 2000);

    function AutoUpdateStatus() {

    $.ajax({
        type: "POST",
        url: '@Url.Action("AutoUpdateStatus", "Unload")',
        success: function (res) {

            if (res.success) {
                GetTableData();
            }
        }
    });
}
</script>
