@model S1947.Models.LoadingSheetModel

@{
    ViewBag.Title = "Cell Block / Unblock";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        margin: 0;
        padding: 0;
        background: #dfe6ee;
        font-family: "Segoe UI", Arial, sans-serif;
    }

    .content-body.expanded {
        padding-right: 15px;
    }

    .cell-control-page {
        width: 100%;
        padding-bottom: 25px;
    }

    /* =========================================================
       PAGE HEADER
       ========================================================= */

    .cell-header {
        margin: -36px -37px 22px -37px;
        padding: 12px 20px;
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        border-bottom: 3px solid #ff6a00;
        color: #ffffff;
        box-shadow: 0 3px 12px rgba(0, 0, 0, .15);
    }

    .cell-header-title {
        margin: 0;
        font-size: 25px;
        line-height: 1.2;
        font-weight: 700;
        letter-spacing: .2px;
    }

    .cell-header-subtitle {
        margin: 5px 0 0;
        font-size: 12px;
        color: #cbd5e1;
    }

    .live-indicator {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 14px;
        border-radius: 20px;
        background: rgba(16, 185, 129, .10);
        border: 1px solid rgba(16, 185, 129, .35);
        color: #6ee7b7;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .5px;
    }

    .live-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #10b981;
        animation: livePulse 1.5s infinite;
    }

    @@keyframes livePulse {
        0% {
            box-shadow: 0 0 0 0 rgba(16, 185, 129, .7);
        }

        70% {
            box-shadow: 0 0 0 7px rgba(16, 185, 129, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
        }
    }


    /* =========================================================
       MAIN CARD
       ========================================================= */

    .cell-control-card {
        width: 100%;
        max-width: none;
        background: #ffffff;
        border: 1px solid #d5dde7;
        border-radius: 10px;
        box-shadow: 0 4px 20px rgba(15, 23, 42, .08);
        overflow: hidden;
    }


    /* =========================================================
       CARD TOOLBAR
       ========================================================= */

    .cell-toolbar {
        padding: 15px 18px;
        background: #ffffff;
        border-bottom: 1px solid #cbd5e1;
    }

    .toolbar-left {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .cell-icon {
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 7px;
        background: #fff7ed;
        color: #ea580c;
        font-size: 17px;
        font-weight: 700;
        border: 1px solid #fed7aa;
    }

    .cell-title {
        margin: 0;
        color: #111827;
        font-size: 17px;
        font-weight: 700;
    }

    .cell-subtitle {
        margin: 3px 0 0;
        color: #64748b;
        font-size: 11px;
    }


    /* =========================================================
       CONTROL BODY
       ========================================================= */

    .cell-control-body {
        padding: 20px;
        background: #f8fafc;
    }

    .operation-panel {
        background: #ffffff;
        border: 1px solid #d5dde7;
        border-radius: 9px;
        overflow: hidden;
        height: 100%;
    }

    .operation-header {
        padding: 13px 16px;
        border-bottom: 1px solid #cbd5e1;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .operation-header.block-header {
            background: #fff7f7;
        }

        .operation-header.unblock-header {
            background: #f3fbf7;
        }

    .operation-icon {
        width: 32px;
        height: 32px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        font-weight: 700;
    }

    .block-icon {
        background: #fee2e2;
        border: 1px solid #fca5a5;
        color: #b91c1c;
    }

    .unblock-icon {
        background: #d1fae5;
        border: 1px solid #86efac;
        color: #047857;
    }

    .operation-title {
        margin: 0;
        font-size: 14px;
        font-weight: 700;
        color: #111827;
    }

    .operation-description {
        margin: 2px 0 0;
        font-size: 10px;
        color: #64748b;
    }

    .operation-content {
        padding: 18px;
    }


    /* =========================================================
       FORM
       ========================================================= */

    .location-label {
        display: block;
        margin-bottom: 7px;
        color: #334155;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .35px;
    }

    .location-select {
        width: 100%;
        height: 40px;
        padding: 7px 12px;
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        color: #1e293b;
        font-size: 12px;
        font-weight: 600;
        outline: none;
        transition: border-color .15s ease, box-shadow .15s ease;
    }

        .location-select:focus {
            border-color: #60a5fa;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, .10);
        }


    /* =========================================================
       BUTTONS
       ========================================================= */

    .operation-button {
        width: 100%;
        height: 42px;
        margin-top: 16px;
        border: none;
        border-radius: 6px;
        color: #ffffff;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .35px;
        cursor: pointer;
        transition: all .15s ease;
    }

    .block-button {
        background: #dc2626;
        border: 1px solid #b91c1c;
    }

        .block-button:hover {
            background: #b91c1c;
        }

        .block-button:active {
            transform: translateY(1px);
        }

    .unblock-button {
        background: #047857;
        border: 1px solid #065f46;
    }

        .unblock-button:hover {
            background: #065f46;
        }

        .unblock-button:active {
            transform: translateY(1px);
        }

    .operation-button:disabled {
        opacity: .65;
        cursor: not-allowed;
    }


    /* =========================================================
       STATUS
       ========================================================= */

    .status-box {
        min-height: 38px;
        margin-top: 13px;
        padding: 9px 11px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 700;
        line-height: 1.3;
        display: flex;
        align-items: center;
    }

        .status-box:empty {
            display: none;
        }

    .status-success {
        color: #047857;
        background: #d1fae5;
        border: 1px solid #6ee7b7;
    }

    .status-error {
        color: #b91c1c;
        background: #fee2e2;
        border: 1px solid #fca5a5;
    }


    /* =========================================================
       INFORMATION BOX
       ========================================================= */

    .cell-info {
        margin-top: 15px;
        padding: 11px 13px;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 6px;
        color: #1e40af;
        font-size: 10px;
        line-height: 1.5;
    }

        .cell-info strong {
            font-weight: 700;
        }


    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 767px) {

        .cell-header {
            margin-left: -25px;
            margin-right: -25px;
        }

        .cell-control-body {
            padding: 12px;
        }

        .operation-panel {
            margin-bottom: 15px;
        }

        .toolbar-left {
            align-items: flex-start;
        }

        .live-indicator {
            display: none;
        }
    }
</style>


<section role="main" class="cell-control-page">

    <!-- =========================================================
         PAGE HEADER
         ========================================================= -->

    <header class="cell-header">

        <div class="d-flex justify-content-between align-items-center">

            <div>

                <h3 class="cell-header-title">
                    Cell Block / Unblock
                </h3>

                <p class="cell-header-subtitle">
                    Warehouse cell availability and location control
                </p>
            </div>
        </div>
    </header>


    <!-- =========================================================
         MAIN CARD
         ========================================================= -->

    <div class="cell-control-card">
        <div class="cell-control-body">

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="row">


                    <!-- =================================================
                         BLOCK CELL
                         ================================================= -->

                    <div class="col-md-6">

                        <div class="operation-panel">

                            <div class="operation-header block-header">

                                <div class="operation-icon block-icon">
                                    <i class="fas fa-lock"></i>
                                </div>

                                <div>

                                    <h5 class="operation-title">
                                        Block Cell
                                    </h5>

                                    <p class="operation-description">
                                        Select an available cell to block
                                    </p>

                                </div>

                            </div>


                            <div class="operation-content">

                                <div class="form-group">

                                    <label class="location-label"
                                           for="LocationId">

                                        Select Location

                                    </label>

                                    @Html.DropDownListFor(
                                        m => m.LocationId,
                                        (SelectList)ViewBag.LocationList,
                                        "-- Select Location --",
                                        new
                                        {
                                            @class = "location-select",
                                            id = "LocationId"
                                        }
                                    )

                                </div>


                                <button type="button"
                                        id="btnBlock"
                                        class="operation-button block-button">

                                    <i class="fas fa-lock mr-1"></i>
                                    BLOCK SELECTED LOCATION

                                </button>


                                <div id="blockStatus"
                                     class="status-box">
                                </div>


                                <div class="cell-info">

                                    <strong>Block rule:</strong>
                                    Only available cells with no loaded
                                    material can be blocked.

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         UNBLOCK CELL
                         ================================================= -->

                    <div class="col-md-6">

                        <div class="operation-panel">

                            <div class="operation-header unblock-header">

                                <div class="operation-icon unblock-icon">
                                    <i class="fas fa-unlock"></i>
                                </div>

                                <div>

                                    <h5 class="operation-title">
                                        Unblock Cell
                                    </h5>

                                    <p class="operation-description">
                                        Select a blocked cell to make it available
                                    </p>

                                </div>

                            </div>


                            <div class="operation-content">

                                <div class="form-group">

                                    <label class="location-label"
                                           for="LocationId1">

                                        Select Location

                                    </label>

                                    @Html.DropDownListFor(
                                        m => m.LocationId1,
                                        (SelectList)ViewBag.LocationList1,
                                        "-- Select Location --",
                                        new
                                        {
                                            @class = "location-select",
                                            id = "LocationId1"
                                        }
                                    )

                                </div>


                                <button type="button"
                                        id="btnUnblock"
                                        class="operation-button unblock-button">

                                    <i class="fas fa-unlock mr-1"></i>
                                    UNBLOCK SELECTED LOCATION

                                </button>


                                <div id="unblockStatus"
                                     class="status-box">
                                </div>


                                <div class="cell-info">

                                    <strong>Unblock rule:</strong>
                                    Only cells currently marked as blocked
                                    are available for unblocking.

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            }

        </div>

    </div>

</section>


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>

    $(document).ready(function () {


        // =========================================================
        // BLOCK CELL
        // =========================================================

        $("#btnBlock").click(function () {

            var button = $(this);

            var locationId =
                $("#LocationId").val();

            var locationText =
                $("#LocationId option:selected").text();


            if (!locationId) {

                $("#blockStatus")
                    .removeClass("status-success")
                    .addClass("status-error")
                    .text("✖ Please select a location.");

                return;
            }


            button.prop("disabled", true);

            $("#blockStatus")
                .removeClass("status-success status-error")
                .text("");


            $.ajax({

                type: "POST",
                url: '@Url.Action("BlockCell", "CellBlockUnblock")',
                data: {
                    locationId: locationId
                },


                success: function (res) {

                    if (res.success) {

                        $("#blockStatus")
                            .removeClass("status-error")
                            .addClass("status-success")
                            .text("✔ " + res.message);


                        // Remove selected item from block dropdown
                        $("#LocationId option:selected")
                            .remove();


                        $("#LocationId")
                            .val("");


                        // Add location to unblock dropdown
                        if (
                            $("#LocationId1 option[value='" +
                            locationId +
                            "']").length === 0
                        ) {

                            $("#LocationId1").append(
                                $("<option>", {
                                    value: locationId,
                                    text: locationText
                                })
                            );

                        }

                    }
                    else {

                        $("#blockStatus")
                            .removeClass("status-success")
                            .addClass("status-error")
                            .text("✖ " + res.message);

                    }

                },


                error: function () {

                    $("#blockStatus")
                        .removeClass("status-success")
                        .addClass("status-error")
                        .text(
                            "✖ Server error while blocking location."
                        );

                },


                complete: function () {

                    button.prop("disabled", false);

                }

            });

        });



        // =========================================================
        // UNBLOCK CELL
        // =========================================================

        $("#btnUnblock").click(function () {

            var button = $(this);

            var locationId = $("#LocationId1").val();
            var locationText = $("#LocationId1 option:selected").text();

            if (!locationId) {

                $("#unblockStatus")
                    .removeClass("status-success")
                    .addClass("status-error")
                    .text("✖ Please select a location.");

                return;
            }


            button.prop("disabled", true);
            $("#unblockStatus")
                .removeClass("status-success status-error")
                .text("");

            $.ajax({
                type: "POST",
                url: '@Url.Action("UnblockCell", "CellBlockUnblock")',
                data: {
                    locationId: locationId
                },
                success: function (res) {
                    if (res.success) {

                        $("#unblockStatus")
                            .removeClass("status-error")
                            .addClass("status-success")
                            .text("✔ " + res.message);

                        // Remove selected item from unblock dropdown
                        $("#LocationId1 option:selected").remove();
                        $("#LocationId1").val("");

                        // Add location back to block dropdown
                        if (
                            $("#LocationId option[value='" +
                            locationId +
                            "']").length === 0
                        ) {

                            $("#LocationId").append(
                                $("<option>", {
                                    value: locationId,
                                    text: locationText
                                })
                            );
                        }
                    }
                    else {

                        $("#unblockStatus")
                            .removeClass("status-success")
                            .addClass("status-error")
                            .text("✖ " + res.message);

                    }

                },


                error: function () {

                    $("#unblockStatus")
                        .removeClass("status-success")
                        .addClass("status-error")
                        .text(
                            "✖ Server error while unblocking location."
                        );

                },


                complete: function () {

                    button.prop("disabled", false);

                }

            });

        });

    });

</script>
