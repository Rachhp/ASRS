                $("#loadingTableContainer input")
                    .prop("readonly", false);

                $("#loadingTableContainer select")
                    .prop("disabled", false);


                $(".saveRow")
                    .prop("disabled", false)
                    .removeClass("btn-secondary")
                    .addClass("btn-success")
                    .text("Add");


                calculateTotal();


                // If there are no rows, create one
                if ($("#loadingTableContainer tr").length === 0) {
                    addNewRow();
                }

            }
