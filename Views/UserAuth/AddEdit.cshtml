@using S1947.Models
@model S1947.Models.UserAuthorizationValidation

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "User Authorization";

    var modules = ViewBag.Modules as List<Menulist>;
    var existingAuth = ViewBag.ExistingAuth as List<UserAuthorization>;
}

<link href="~/Content/css/MaterialMaster.css" rel="stylesheet" />

<style>
    .auth-switch {
        position: relative;
        display: inline-block;
        width: 55px;
        height: 28px;
        margin: 0;
        vertical-align: middle;
    }

        .auth-switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .auth-slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        transition: .3s;
        border-radius: 30px;
    }

        .auth-slider:before {
            position: absolute;
            content: "";
            height: 22px;
            width: 22px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: .3s;
            border-radius: 50%;
        }

    .auth-switch input:checked + .auth-slider {
        background-color: #28a745;
    }

        .auth-switch input:checked + .auth-slider:before {
            transform: translateX(27px);
        }

    .auth-text {
        display: inline-block;
        margin-left: 10px;
        min-width: 140px;
        text-align: left;
        font-weight: 600;
    }

    .page-header {
        margin: -35px -36px 40px -38px;
        border-bottom: 5px solid #ff6a00;
    }

    #loading {
        display: none;
    }

    .module-table thead th {
        background: #003366;
        color: white;
        position: sticky;
        top: 0;
        z-index: 5;
    }

    .authorized-row {
        background-color: #d9ffd9 !important;
    }

    .module-table td {
        vertical-align: middle;
    }
</style>

<section role="main">

    <form id="authForm">

        @Html.AntiForgeryToken()

        <header class="page-header d-flex justify-content-between align-items-center mb-4 p-3 shadow-sm"
                style="background:#000;color:#fff;">

            <div>

                <h3 class="mb-4 font-weight-bold">

                    <i class="fas fa-user-shield"></i>

                    User Authorization

                </h3>

            </div>

            <div>

                <a href="@Url.Action("Index","UserAuth")"
                   class="btn btn-danger">

                    <i class="fas fa-arrow-left"></i>

                    Back

                </a>

            </div>

        </header>


        <div class="card">

            <div class="card-body">


                <!-- ================================================= -->
                <!-- USER -->
                <!-- ================================================= -->

                <div class="form-group row">

                    <label class="col-lg-2 control-label text-lg-right pt-2">

                        User Name

                    </label>

                    <div class="col-lg-4">

                        @Html.DropDownListFor(
                            x => x.UserNo,
                            ViewBag.UserNo as SelectList,
                            "-- Select User --",
                            new
                            {
                                @class = "form-control",
                                id = "UserNo"
                            })

                    </div>

                </div>


                <hr />


                <!-- ================================================= -->
                <!-- MODULE TABLE -->
                <!-- ================================================= -->

                <div class="table-responsive"
                     style="max-height:600px;overflow-y:auto;">

                    <table class="table table-bordered table-hover module-table"
                           id="moduleTable">

                        <thead>

                            <tr>

                                <th width="5%">
                                    S.No
                                </th>

                                <th width="45%">
                                    Module
                                </th>

                                <th width="25%">
                                    Module Type
                                </th>

                                <th width="25%">
                                    Authorization
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @if (modules != null && modules.Count > 0)
                            {
                                int sno = 0;

                                foreach (var module in modules)
                                {
                                    sno++;

                                    var auth = existingAuth?
                                        .FirstOrDefault(x =>
                                            x.ModuleNo == module.MTransNo &&
                                            x.ModuleType == module.ModuleType);

                                    string authType =
                                        auth != null &&
                                        auth.AuthType == "F"
                                        ? "F"
                                        : "N";

                                    <tr class="@(authType == "F" ? "authorized-row" : "")"
                                        data-moduleno="@module.MTransNo"
                                        data-moduletype="@module.ModuleType">

                                        <td>
                                            @sno
                                        </td>

                                        <td>
                                            @module.ModuleName
                                        </td>

                                        <td>
                                            @module.ModuleType
                                        </td>
                                        <td class="text-center">

                                            <label class="auth-switch">

                                                <input type="checkbox"
                                                       class="authType"
                                                       value="F"
                                                       @(authType == "F" ? "checked" : "") />

                                                <span class="auth-slider"></span>

                                            </label>

                                            <span class="auth-text">
                                                @(authType == "F" ? "Full Authorization" : "No Authorization")
                                            </span>

                                        </td>

                                        @*<td>

            <select class="form-control authType">

                <option value="N"
                        @(authType == "N" ? "selected" : "")>
                    No Authorization
                </option>

                <option value="F"
                        @(authType == "F" ? "selected" : "")>
                    Full Authorization
                </option>

            </select>

        </td>*@

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>

                                    <td colspan="4"
                                        class="text-center text-danger">

                                        No modules found in Menulist table.

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>


                <br />


                <!-- ================================================= -->
                <!-- BUTTONS -->
                <!-- ================================================= -->

                <div class="text-center">

                    <button type="button"
                            id="btnSave"
                            class="btn btn-success btn-lg">

                        <i class="fas fa-save"></i>

                        Save Authorization

                    </button>


                    <a href="@Url.Action("Index","UserAuth")"
                       class="btn btn-danger btn-lg">

                        Cancel

                    </a>

                </div>

            </div>

        </div>

    </form>

</section>


<script>

$(document).ready(function () {

    // =============================================================
    // USER CHANGE
    // =============================================================

    $("#UserNo").change(function () {

        var userNo = $(this).val();

        if (!userNo) {

            return;

        }

        /*
         * For now the modules are already loaded from Menulist.
         *
         * Later, if you want changing the user without page reload,
         * we can make this AJAX.
         */

    });


    // =============================================================
    // AUTHORIZATION CHANGE
    // =============================================================

    $("#moduleTable").on("change", ".authType", function () {

        var checkbox = $(this);

        var row = checkbox.closest("tr");

        var text = row.find(".auth-text");


        if (checkbox.is(":checked")) {

            text.text("Full Authorization");

            row.addClass("authorized-row");

        }
        else {

            text.text("No Authorization");

            row.removeClass("authorized-row");

        }

    });


    // =============================================================
    // SAVE
    // =============================================================

  $("#btnSave").click(function () {

    var userNo = $("#UserNo").val();

    if (!userNo || userNo === "0") {

        alert("Please select a user.");

        $("#UserNo").focus();

        return false;
    }


    var authorizationData = "";

    var selectedCount = 0;


    $("#moduleTable tbody tr[data-moduleno]").each(function () {

        var row = $(this);

        var moduleNo = row.attr("data-moduleno");

        var moduleType = row.attr("data-moduletype");

        var authType =
            row.find(".authType").is(":checked")
                ? "F"
                : "N";


        if (authType === "F") {

            selectedCount++;

        }


        if (authorizationData !== "") {

            authorizationData += "~";

        }


        authorizationData +=
            moduleNo + "^" +
            moduleType + "^" +
            authType;

    });


    // =========================================================
    // NOTHING SELECTED
    // =========================================================

    if (selectedCount === 0) {

        alert(
            "Please select at least one module for Full Authorization."
        );

        $("#btnSave").prop("disabled", false);

        return false;
    }


    // =========================================================
    // SAVE
    // =========================================================

    $("#btnSave").prop("disabled", true);


    $.ajax({

        type: "POST",

        url: '@Url.Action("SaveAuthorization", "UserAuth")',

        data: {

            UserNo: userNo,

            AuthorizationData: authorizationData,

            __RequestVerificationToken:
                $('input[name="__RequestVerificationToken"]').val()

        },

        success: function (response) {

            if (response.success) {

                alert(response.message);

                window.location.href =
                    '@Url.Action("Index", "UserAuth")';

            }
            else {

                alert(response.message);

                $("#btnSave").prop("disabled", false);

            }

        },

        error: function (xhr) {

            console.log(xhr.responseText);

            alert("Error while saving authorization.");

            $("#btnSave").prop("disabled", false);

        }

    });

});


});

</script>
