@using S1947.Models
@model List<S1947.Models.UserAuthorizationValidation>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "User Authorization";
}
<div id="loading"></div>
<link href="@Url.Content("~/Content/css/MaterialMaster.css")" rel="stylesheet" />
<style>
    .page-header {
        margin: -36px -37px 40px -37px;
        border-bottom: 5px solid #ff6a00;
    }
    .table-responsive {
        max-height: 600px;
        overflow-y: auto;
    }
    #datatable-tabletools thead th {
        position: sticky;
        top: 0;
        background-color: #003366;
        color: #fff;
        z-index: 10;
    }
    .custom-toast1 {
        background: linear-gradient(to right, #28a745, #218838);
        border-radius: 10px;
        padding: 20px 28px;
        font-weight: bold;
        font-size: 18px;
        color: #fff;
        box-shadow: 0 16px 32px rgba(0,0,0,.25);
        max-width: 600px;
        min-width: 400px;
        text-align: center;
        position: fixed;
        top: 30px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 9999;
        display: none;
    }
    .custom-toast {
        background: linear-gradient(to right, #ff416c, #ff4b2b);
        border-radius: 10px;
        padding: 20px 28px;
        font-weight: bold;
        font-size: 18px;
        color: #fff;
        box-shadow: 0 30px 60px rgba(0,0,0,.3);
        max-width: 600px;
        min-width: 400px;
        text-align: center;
        position: fixed;
        top: 30px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 9999;
        display: none;
    }
</style>
<section role="main">
    <header class="page-header d-flex justify-content-between align-items-center mb-4 p-3 shadow-sm"
            style="background:#000;color:#fff;border-radius:6px;">
        <div>
            <h3 class="mb-4 font-weight-bold">
                <i class="fas fa-user-shield fa-xs"></i>
                User Authorization
            </h3>
        </div>
        <div class="text-center flex-grow-1">
            <a href="@Url.Action("AddEdit", "UserAuth")"
               class="btn btn-primary btn-lg px-4"
               style="border-radius:30px;">
                <i class="fas fa-plus-circle mr-1"></i>
                Add New
            </a>
        </div>
        <div>
            <ol class="breadcrumbs mb-0"
                style="list-style:none;padding-left:0;display:flex;gap:15px;font-size:18px;">
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Dashboard", "Home")"
                       style="color:#fff;">
                        <i class="fas fa-home"></i>
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("MastersManagement", "Home")"
                       style="color:#fff;">
                        <i class="fas fa-sign-out-alt"></i>
                    </a>
                </li>
            </ol>
        </div>
    </header>
    @Html.AntiForgeryToken()
    <div class="card-modern">
        <div class="table-responsive">
            <input type="text"
                   id="searchInput"
                   class="form-control mb-2"
                   placeholder="Search user..." />
            <table class="table table-bordered table-hover"
                   id="datatable-tabletools">
                <thead>
                    <tr>
                        <th width="5%">SNo.</th>
                        <th width="30%">User Name</th>
                        <th width="25%">Login ID</th>
                        <th width="15%">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int rowNo = 0;
                    }
                    @if (Model == null || Model.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="text-center text-danger font-weight-bold p-4">
                                <i class="fas fa-info-circle mr-2"></i>
                                No users found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td> @(++rowNo) </td>
                                <td> @item.UserName</td>
                                <td>@item.UserId</td>
                                <td class="text-center">
                                <button type="button" class="btn btn-info btn-xs RecEdit" title="Edit" data-userno="@item.UserNo">
                                 <i class="fas fa-pencil-alt"></i></button>
                                <button type="button" class="btn btn-danger btn-xs Delete" title="Delete"data-userno="@item.UserNo">
                                 <i class="fas fa-trash-alt"></i> </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
<script>
    $(document).ready(function () {
        $("#loading").hide();
        // EDIT
        $("#datatable-tabletools").on("click", ".RecEdit", function () {
            var userNo = $(this).data("userno");
            if (!userNo) {
                alert("Invalid user.");
                return;
            }
            window.location.href ='@Url.Action("AddEdit", "UserAuth")' + '?UserNo=' + userNo;});

        // DELETE
        $("#datatable-tabletools").on("click", ".Delete", function () {
            var userNo = $(this).data("userno");
            if (!userNo) {
                alert("Invalid user.");
                return;
            }
            if (!confirm(
                "Are you sure you want to remove all authorization for this user?"
            )) {
                return;
            }
            var token = $('input[name="__RequestVerificationToken"]').val();
            $.ajax({
                type: "POST",
                url: '@Url.Action("Delete", "UserAuth")',
                data: {
                    UserNo: userNo,
                    __RequestVerificationToken: token
                },
                success: function (result) {
                    if (result.success) {
                        alert(result.message);
                        location.reload();
                    }
                    else {
                        alert(result.message);
                    }
                },
                error: function (xhr) {
                    alert(
                        "Unable to delete authorization."
                    );
                }
            });
        });

        // SEARCH
        $("#searchInput").on("keyup", function () {
            var value =
                $(this).val().toLowerCase();
            $("#datatable-tabletools tbody tr").filter(function () {
                $(this).toggle(
                    $(this).text().toLowerCase().indexOf(value) > -1
                );
            });
        });
    });
</script>
