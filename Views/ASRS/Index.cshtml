@model S1947.Models.ASRSViewModel
@*<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">*@
<style>
  /* =========================================================
   ASRS DASHBOARD - MODERN UI
   ========================================================= */

:root {
    --bg: #eef2f6;
    --card: #ffffff;
    --primary: #2563eb;
    --primary-dark: #1d4ed8;
    --dark: #172033;
    --dark-2: #25304a;
    --border: #dbe2ea;

    --available: #16a34a;
    --available-light: #dcfce7;

    --loaded: #dc2626;
    --loaded-light: #fee2e2;

    --selected: #f59e0b;
    --selected-light: #fef3c7;

    --no-location: #64748b;
    --no-location-light: #e2e8f0;

    --text: #1e293b;
    --muted: #64748b;
}

/* =========================
   PAGE
   ========================= */

body {
    margin: 0;
    background:
        radial-gradient(circle at top left, #ffffff 0%, transparent 35%),
        linear-gradient(135deg, #eef2f6 0%, #e5eaf1 100%);
    color: var(--text);
    font-family: "Segoe UI", Arial, sans-serif;
}

/* =========================
   PAGE TITLE
   ========================= */

.page-title {
    margin: 25px 0 22px;
    text-align: center;
    font-size: 30px;
    font-weight: 800;
    letter-spacing: 1px;
    color: var(--dark);
}

.page-title::after {
    content: "";
    display: block;
    width: 65px;
    height: 4px;
    margin: 9px auto 0;
    border-radius: 10px;
    background: linear-gradient(90deg, #2563eb, #60a5fa);
}

/* =========================
   MAIN CARD
   ========================= */

.asrs-container {
    background: rgba(255, 255, 255, 0.96);
    padding: 22px;
    border-radius: 16px;
    border: 1px solid rgba(255,255,255,0.8);
    box-shadow:
        0 10px 30px rgba(15, 23, 42, 0.08),
        0 2px 6px rgba(15, 23, 42, 0.04);

    overflow-x: auto;
    overflow-y: hidden;
}

/* Section heading */

.asrs-container h5 {
    color: var(--dark);
    font-weight: 700;
    letter-spacing: .4px;
    margin-bottom: 18px !important;
}

/* =========================
   ASRS TABLE
   ========================= */

.asrs-table {
    border-collapse: separate;
    border-spacing: 5px;
    margin: auto;
}

.asrs-table th {
    text-align: center;
    font-weight: 700;
    font-size: 11px;
    color: #e2e8f0;
    background: linear-gradient(135deg, #1e293b, #334155);
    min-width: 58px;
    height: 35px;
    border-radius: 6px;
    white-space: nowrap;
}

.asrs-table tr > th:first-child {
    position: sticky;
    left: 0;
    z-index: 5;
    min-width: 65px;
}

/* =========================
   STORAGE CELL
   ========================= */

.level-cell {
    position: relative;

    height: 52px;
    width: 62px;

    background: linear-gradient(
        145deg,
        #9bd487,
        #78b568
    );

    color: #183018;

    display: flex;
    justify-content: center;
    align-items: center;

    border: 1px solid #70a960;
    border-radius: 8px;

    cursor: pointer;

    font-size: 11px;
    font-weight: 700;

    box-shadow:
        inset 0 1px 1px rgba(255,255,255,.45),
        0 2px 4px rgba(0,0,0,.05);

    transition:
        transform .15s ease,
        box-shadow .15s ease,
        background .15s ease,
        border .15s ease;
}

.level-cell:hover {
    background: linear-gradient(
        145deg,
        #bfdbfe,
        #93c5fd
    );

    border-color: #3b82f6;

    transform: translateY(-2px) scale(1.03);

    box-shadow:
        0 5px 12px rgba(37,99,235,.18);
}

.level-cell.selected {
    background: linear-gradient(
        145deg,
        #fbbf24,
        #f59e0b
    );

    border: 2px solid #d97706;

    color: #422006;

    transform: translateY(-2px) scale(1.04);

    box-shadow:
        0 5px 15px rgba(245,158,11,.35);
}

.level-cell.selected::before {
    content: "";
    position: absolute;
    inset: -4px;
    border: 2px solid rgba(245,158,11,.25);
    border-radius: 10px;
    pointer-events: none;
}

/* =========================
   POSITION PANEL
   ========================= */

.position-panel {
    background: rgba(255,255,255,.97);

    margin-top: 22px;
    padding: 22px;

    border-radius: 16px;

    border: 1px solid var(--border);

    box-shadow:
        0 10px 30px rgba(15,23,42,.08),
        0 2px 6px rgba(15,23,42,.04);
}

.position-panel h5 {
    margin: 0;
    color: var(--dark);
    font-size: 17px;
    font-weight: 700;
}

#selectedLocation {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-width: 70px;
    padding: 5px 12px;

    margin-left: 6px;

    border-radius: 20px;

    background: #dbeafe;
    color: #1d4ed8;

    font-size: 14px;
    font-weight: 800;
}

.position-panel hr {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 18px 0;
}

/* =========================
   POSITION AREA
   ========================= */

.position-area {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;

    min-height: 120px;

    padding: 18px;

    border-radius: 12px;

    background:
        linear-gradient(
            135deg,
            #f8fafc,
            #f1f5f9
        );

    border: 1px dashed #cbd5e1;
}

/* =========================
   POSITION BOX
   ========================= */

.position-box {
    width: 82px;
    height: 96px;

    border: 1px solid #cbd5e1;
    border-radius: 12px;

    padding: 6px;

    cursor: pointer;

    text-align: center;

    display: flex;
    flex-direction: column;

    justify-content: center;
    align-items: center;

    font-size: 10px;
    font-weight: 700;

    box-shadow:
        0 3px 8px rgba(15,23,42,.08);

    transition:
        transform .15s ease,
        box-shadow .15s ease;
}

.position-box:hover {
    transform: translateY(-3px);

    box-shadow:
        0 8px 16px rgba(15,23,42,.13);
}

/* =========================
   LOADED
   ========================= */

.position-box.loaded {
    background: linear-gradient(
        145deg,
        #ef4444,
        #dc2626
    );

    border-color: #b91c1c;
    color: white;

    box-shadow:
        0 4px 12px rgba(220,38,38,.25);
}

/* =========================
   AVAILABLE
   ========================= */

.position-box.empty {
    background: linear-gradient(
        145deg,
        #22c55e,
        #16a34a
    );

    border-color: #15803d;
    color: white;

    box-shadow:
        0 4px 12px rgba(22,163,74,.20);
}

/* =========================
   NO LOCATION
   ========================= */

.position-box.no-location {
    background: linear-gradient(
        145deg,
        #64748b,
        #475569
    );

    border-color: #475569;
    color: white;
}

/* =========================
   PALLET IMAGE
   ========================= */

.pallet-img {
    width: 40px;
    height: 40px;

    object-fit: contain;

    display: block;

    margin: 4px 0;
}

/* =========================
   AISLE / GAP
   ========================= */

.gap-box {
    height: 96px;
    min-width: 70px;

    padding: 8px;

    display: flex;
    justify-content: center;
    align-items: center;

    border-radius: 10px;

    background:
        repeating-linear-gradient(
            45deg,
            #f1f5f9,
            #f1f5f9 8px,
            #e2e8f0 8px,
            #e2e8f0 16px
        );

    border: 1px dashed #94a3b8;

    color: #64748b;

    font-size: 10px;
    font-weight: 800;

    letter-spacing: .7px;
}

/* =========================
   EMPTY INITIAL MESSAGE
   ========================= */

#positionArea:empty::before {
    content: "Select a storage location to view positions";
    color: #94a3b8;
    font-size: 13px;
}

/* =========================
   ALERT
   ========================= */

.position-panel .alert {
    margin: 0;
    border-radius: 10px;
}

/* =========================
   SCROLLBAR
   ========================= */

.asrs-container::-webkit-scrollbar {
    height: 8px;
}

.asrs-container::-webkit-scrollbar-track {
    background: #e2e8f0;
    border-radius: 10px;
}

.asrs-container::-webkit-scrollbar-thumb {
    background: #94a3b8;
    border-radius: 10px;
}

.asrs-container::-webkit-scrollbar-thumb:hover {
    background: #64748b;
}

/* =========================
   RESPONSIVE
   ========================= */

@@media (max-width: 768px) {

    .page-title {
        font-size: 23px;
    }

    .asrs-container {
        padding: 12px;
    }

    .level-cell {
        width: 56px;
        height: 48px;
        font-size: 10px;
    }

    .position-panel {
        padding: 15px;
    }

    .position-area {
        padding: 12px;
        gap: 7px;
    }

    .position-box {
        width: 72px;
        height: 88px;
    }

    .gap-box {
        min-width: 55px;
        height: 88px;
    }
}
    /* =========================
   STATUS LEGEND
   ========================= */

    .asrs-legend {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 18px;
        margin-bottom: 18px;
        padding: 10px 15px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 12px;
        font-weight: 600;
        color: #475569;
    }

    .legend-color {
        width: 14px;
        height: 14px;
        border-radius: 4px;
        display: inline-block;
    }

        .legend-color.available {
            background: #16a34a;
        }

        .legend-color.selected {
            background: #f59e0b;
        }

        .legend-color.loaded {
            background: #dc2626;
        }

        .legend-color.no-location {
            background: #64748b;
        }
</style>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<div class="container-fluid">
    <div class="page-title">
        ASRS STORAGE VIEW
    </div>
    <div class="asrs-container">
        <h5 class="text-center mb-3">
            LEVEL / COLUMN VIEW
        </h5>
        <div class="asrs-legend">

            <div class="legend-item">
                <span class="legend-color available"></span>
                Available
            </div>

            <div class="legend-item">
                <span class="legend-color selected"></span>
                Selected
            </div>

            <div class="legend-item">
                <span class="legend-color loaded"></span>
                Loaded
            </div>

            <div class="legend-item">
                <span class="legend-color no-location"></span>
                No Location
            </div>

        </div>
        <table class="asrs-table">
            <tr>
                <th>LEVEL </th>
                @for (int c = 1; c <= 42; c++)
                {
                    <th>C@(c)</th>
                }
            </tr>
            @for (int l = 8; l >= 1; l--)
            {
                <tr>
                    <th> L@(l) </th>
                    @for (int c = 1; c <= 42; c++)
                    {
                        <td>
                            <div class="level-cell" data-level="@l" data-column="@c">
                                <div> L@(l)C@(c)</div>
                            </div>
                        </td>
                    }
                </tr>
            }
        </table>
    </div>
    <!-- POSITION VIEW -->
    <div class="position-panel">
        <h5>
            Selected Location :
            <span id="selectedLocation">
                -
            </span>
        </h5>
        <hr>
        <div id="positionArea">
            Click any LxCy block
        </div>
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>

    $(".level-cell").click(function () {

        // -----------------------------
        // SELECTED LEVEL / COLUMN
        // -----------------------------
        $(".level-cell").removeClass("selected");
        $(this).addClass("selected");

        var level = $(this).data("level");
        var column = $(this).data("column");

        $("#selectedLocation").text("L" + level + "C" + column);


        // -----------------------------
        // GET DATA FROM DATABASE
        // -----------------------------
        $.ajax({
            url: '@Url.Action("GetPositions", "ASRS")',
            type: 'GET',
            data: {
                level: level,
                column: column
            },
            success: function (result) {

                console.log("API RESULT:", result);

                var positions = {};

                $.each(result, function (i, item) {
                    positions[item.Position] = item;
                });

                var html = '<div class="position-area">';

                // P1
                html += renderPosition(positions[1], 1);

                // AISLE
                html += `
                <div class="gap-box">
                AISLE
                </div>
                `;

                // P2-P6
                for (var i = 2; i <= 6; i++) {
                    html += renderPosition(positions[i], i);
                }

                // GAP
                html += `
        <div class="gap-box">
            GAP
        </div>
    `;

                // P7-P12
                for (var i = 7; i <= 12; i++) {
                    html += renderPosition(positions[i], i);
                }

                // AISLE
                html += `
                <div class="gap-box">
                    AISLE
                </div>
            `;

                // P13
                html += renderPosition(positions[13], 13);

                html += '</div>';

                $("#positionArea").html(html);
            },

            error: function () {

                $("#positionArea").html(
                    '<div class="alert alert-danger">Unable to load location details.</div>'
                );

            }

        });

    });




    function renderPosition(item, position) {

        // No record exists in database
        if (!item) {
            return `
            <div class="position-box no-location">
                <strong>P${position}</strong>
                <span>No Location</span>
            </div>
        `;
        }

        var status = (item.Status || "").toUpperCase();
        console.log("Position:", position, "Status:", status);


   // =========================
    // OCCUPIED / LOADED
    // =========================
    if (status === "OCCUPIED" || status === "LOADED") {

        return `
            <div class="position-box loaded">
                <strong>P${position}</strong>

                <img src="@Url.Content("~/Content/images/pallets.png")"
                     class="pallet-img"
                     alt="Pallet" />

                <span>${item.PalletNo || '-'}</span>
                <span>Qty : ${item.Qty || 0}</span>
            </div>
        `;
    }

    // =========================
    // AVAILABLE
    // =========================
    if (status === "AVAILABLE") {

        return `
            <div class="position-box empty">
                <strong>P${position}</strong>
                <span>Available</span>
            </div>
        `;
    }

    // =========================
    // NO LOCATION
    // =========================
    if (status === "NOLOCATION" || status === "NO LOCATION") {

        return `
            <div class="position-box no-location">
                <strong>P${position}</strong>
                <span>No Location</span>
            </div>
        `;
    }

    // =========================
    // UNKNOWN STATUS
    // =========================
    return `
        <div class="position-box no-location">
            <strong>P${position}</strong>
            <span>${status || 'Unknown'}</span>
        </div>
    `;
    }
















</script>

