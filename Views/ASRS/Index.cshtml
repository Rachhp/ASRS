@model S1947.Models.ASRSViewModel

@{
    ViewBag.Title = "ASRS Monitor";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/Content/ASRS_Monitor.css" />




<div class="asrs-page">


    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="asrs-topbar">

        <div class="asrs-heading">

            <div class="asrs-heading-icon">
                <i class="fas fa-warehouse"></i>
            </div>

            <div>

                <h1>ASRS Monitor</h1>

                <p>
                    Automated Storage & Retrieval System
                </p>

            </div>

        </div>


        <div class="live-indicator">

            <span class="live-dot"></span>

            LIVE MONITORING

        </div>

    </div>



    <!-- =====================================================
         CONTROL
         ===================================================== -->

    <div class="control-panel">

        @*<button type="button"
                    id="btnSimulateLoading"
                    class="btn btn-success btn-sm"
                    onclick="startLoadingSimulation()">
                <i class="fas fa-play"></i>
                Simulate Loading
            </button>*@

        <button type="button"
                id="btnStopSimulation"
                class="btn btn-danger btn-sm"
                onclick="stopLoadingSimulation()"
                style="display:none;">
            <i class="fas fa-stop"></i>
            Stop
        </button>

        <div class="level-control">

            <span class="level-label">
                Storage Level
            </span>

            <select id="levelSelector"
                    class="level-select">

                @foreach (var level in Model.Levels)
                {
                    <option value="@level">
                        Level @level
                    </option>
                }

            </select>

        </div>


        <div class="last-update">

            <i class="fas fa-sync-alt"></i>

            Last updated:

            <span id="lastUpdate">
                --
            </span>

        </div>

    </div>



    <!-- =====================================================
         SUMMARY
         ===================================================== -->

    <div class="summary-grid">

        <div class="summary-card card-total">

            <div class="summary-label">
                Total Locations
            </div>

            <div class="summary-number"
                 id="totalCount">
                0
            </div>

        </div>


        <div class="summary-card card-empty">

            <div class="summary-label">
                Empty
            </div>

            <div class="summary-number"
                 id="emptyCount">
                0
            </div>

        </div>


        <div class="summary-card card-loaded">

            <div class="summary-label">
                Loaded
            </div>

            <div class="summary-number"
                 id="loadedCount">
                0
            </div>

        </div>


        <div class="summary-card card-available">

            <div class="summary-label">
                Available
            </div>

            <div class="summary-number"
                 id="availableCount">
                0
            </div>

        </div>


        <div class="summary-card card-blocked">

            <div class="summary-label">
                Blocked
            </div>

            <div class="summary-number"
                 id="blockedCount">
                0
            </div>

        </div>

    </div>



    <!-- =====================================================
         STORAGE PANEL
         ===================================================== -->

    <div class="storage-panel">


        <div class="storage-header">

            <div class="storage-title">

                <i class="fas fa-th"></i>

                <span id="mapTitle">
                    Level 8 — Top View
                </span>

            </div>


            <div class="search-box">

                <i class="fas fa-search"></i>

                <input type="text"
                       id="locationSearch"
                       placeholder="Search location..." />

            </div>

        </div>



        <!-- =================================================
         MAP
         ================================================= -->

        <div class="map-wrapper">

            <div class="map-scroll">

                <div class="asrs-map">


                    <!-- =====================================
                    UNLOADING SIDE
                    TOP / HEADER SIDE
                    ===================================== -->
                    <!--<div class="unloading-side">

                        <i class="fas fa-arrow-up"></i>

                        UNLOADING SIDE

                    </div>-->
                    <!-- =====================================
                    LOADING SIDE
                    BELOW ROW 18
                    ===================================== -->

                    <div class="loading-side"
                         id="loadingSide">

                        <span class="loading-arrow">

                            <i class="fas fa-arrow-up"></i>

                            LOADING SIDE

                        </span>

                    </div>


                    <!-- =====================================
                    COLUMN HEADER
                    ===================================== -->

                    <div class="column-header">

                        <div class="corner">
                            ROW
                        </div>


                        @foreach (var column in Model.Columns)
                        {
                            <div class="column">

                                C@(column.ToString("00"))

                            </div>
                        }

                    </div>



                    <div id="loadingSimulationPanel" class="loading-simulation-panel">
                        <div class="simulation-title">
                            <i class="fas fa-truck-loading"></i>
                            Loading Simulation
                        </div>

                        @*<div class="simulation-info">
                                <div>
                                    <span>Step</span>
                                    <strong id="simulationStep">0 / 0</strong>
                                </div>

                                <div>
                                    <span>Pallet</span>
                                    <strong id="simulationPallet">-</strong>
                                </div>

                                <div>
                                    <span>Current Position</span>
                                    <strong id="simulationCurrent">-</strong>
                                </div>

                                <div>
                                    <span>Target</span>
                                    <strong id="simulationTarget">-</strong>
                                </div>

                                <div>
                                    <span>Status</span>
                                    <strong id="simulationStatus">Ready</strong>
                                </div>
                            </div>*@
                    </div>

                    <!-- =====================================
                    ROWS
                    ===================================== -->

                    <div id="gridRows"></div>



                    <!-- =====================================
                    LOADING SIDE
                    BELOW ROW 18
                    ===================================== -->
                    <!--<div class="loading-side"
                         id="loadingSide">

                        <span class="loading-arrow">

                            <i class="fas fa-arrow-up"></i>

                            LOADING SIDE

                        </span>

                    </div>-->
                    <!-- =====================================
                    UNLOADING SIDE
                    TOP / HEADER SIDE
                    ===================================== -->

                    <div class="unloading-side">

                        <i class="fas fa-arrow-up"></i>

                        UNLOADING SIDE

                    </div>

                </div>

            </div>

        </div>



        <!-- =================================================
         LEGEND
         ================================================= -->
        <div class="legend">

            <span class="legend-title">
                STATUS
            </span>

            <div class="legend-item">
                <span class="legend-dot legend-empty"></span>
                Empty
            </div>

            <div class="legend-item">
                <span class="legend-dot legend-loaded"></span>
                Loaded
            </div>

            <div class="legend-item">
                <span class="legend-dot legend-available"></span>
                Available
            </div>

            <div class="legend-item">
                <span class="legend-dot legend-blocked"></span>
                Blocked
            </div>

            <span class="legend-title" style="margin-left:15px;">
                MOVEMENT
            </span>

            <div class="legend-item">
                <span class="movement-dot movement-fast"></span>
                Fast Moving
            </div>

            <div class="legend-item">
                <span class="movement-dot movement-medium"></span>
                Medium Moving
            </div>

            <div class="legend-item">
                <span class="movement-dot movement-slow"></span>
                Slow Moving
            </div>

        </div>
    </div>

</div>



<!-- =========================================================
     BOOKMYSHOW STYLE ZOOM PREVIEW
     ========================================================= -->
@*<div id="zoomPreview"
    class="zoom-preview" hidden>*@

@*<div class="zoom-header">

        <div class="zoom-header-location">

            <i class="fas fa-map-marker-alt"></i>

            <span id="zoomLocation">
                Location
            </span>

        </div>

        <span id="zoomStatus"
              class="zoom-header-status">
            EMPTY
        </span>

    </div>*@


@*<div id="zoomGrid"
         class="zoom-grid">
    </div>


    <div class="zoom-footer">

        <span>
            Row <strong id="zoomRow">-</strong>
        </span>

        <span>
            Column <strong id="zoomColumn">-</strong>
        </span>

        <span>
            Hover to inspect
        </span>

    </div>*@

@*</div>*@



<!-- =========================================================
     LOCATION MODAL
     ========================================================= -->

<div id="locationModal"
     class="asrs-modal-overlay"
     onclick="closeLocationModal(event)">


    <div class="asrs-modal"
         onclick="event.stopPropagation()">


        <div class="modal-header">

            <div class="modal-header-content">

                <div class="modal-location-icon">

                    <i class="fas fa-cube"></i>

                </div>


                <div>

                    <h3 id="modalLocationTitle">
                        Location Details
                    </h3>

                    <small>
                        ASRS Storage Location
                    </small>

                </div>

            </div>


            <div class="modal-close"
                 onclick="closeLocationModal()">

                <i class="fas fa-times"></i>

            </div>

        </div>



        <div class="modal-body">


            <div id="modalStatus"
                 class="modal-status">

                <span class="modal-status-dot"></span>

                <span id="modalStatusText">
                    UNKNOWN
                </span>

            </div>



            <div class="modal-details">


                <div class="modal-detail-card">

                    <div class="modal-detail-label">
                        Location
                    </div>

                    <div class="modal-detail-value"
                         id="modalLocation">
                        -
                    </div>

                </div>


                <div class="modal-detail-card">

                    <div class="modal-detail-label">
                        Level
                    </div>

                    <div class="modal-detail-value"
                         id="modalLevel">
                        -
                    </div>

                </div>


                <div class="modal-detail-card">

                    <div class="modal-detail-label">
                        Column
                    </div>

                    <div class="modal-detail-value"
                         id="modalColumn">
                        -
                    </div>

                </div>


                <div class="modal-detail-card">

                    <div class="modal-detail-label">
                        Row
                    </div>

                    <div class="modal-detail-value"
                         id="modalRow">
                        -
                    </div>

                </div>


                <div class="modal-detail-card">

                    <div class="modal-detail-label">
                        Pallet No
                    </div>

                    <div class="modal-detail-value"
                         id="modalPallet">
                        -
                    </div>

                </div>
                <div class="modal-detail-card">

                    <div class="modal-detail-label">
                        Part
                    </div>

                    <div class="modal-detail-value"
                         id="modalPart">
                        -
                    </div>

                </div>


                <div class="modal-detail-card">

                    <div class="modal-detail-label">
                        Quantity
                    </div>

                    <div class="modal-detail-value"
                         id="modalQty">
                        -
                    </div>

                </div>


            </div>

        </div>



        <div class="modal-footer">

            <button class="modal-close-btn"
                    onclick="closeLocationModal()">

                Close

            </button>

        </div>

    </div>

</div>
<script>
    window.ASRS_URLS = {
        getLevel: '@Url.Action("GetLevel", "ASRS")',
        getSummary: '@Url.Action("GetSummary", "ASRS")',
        getZones: '@Url.Action("GetZones", "ASRS")',
        getLoadingSimulation: '@Url.Action("GetLoadingSimulation", "ASRS")'
    };
</script>



<script src="@Url.Content("~/Scripts/ASRS_Monitor.js")"></script>